{
  "name": "grokbotdev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "validate": "node scripts/validate.mjs",
    "build": "npm run validate && node scripts/check-contrast.mjs && node scripts/check-hub-intros.mjs && astro build && node scripts/build-og.mjs && node scripts/build-redirects.mjs && node scripts/check-keyword-placements.mjs && pagefind --site dist && node scripts/check-links.mjs && node scripts/audit-scripts.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.12",
    "astro": "^5.13.0",
    "matter-js": "^0.20.0",
    "pagefind": "^1.4.0",
    "rehype-sanitize": "^6.0.0",
    "satori": "^0.33.0",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  }
