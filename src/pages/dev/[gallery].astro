const contractMarkdown = `# grokbot.dev — machine contract

base: https://grokbot.dev/api/v1/

GET /api/v1/index.json        directory index + counts
GET /api/v1/latest.json       newest entries, all types
GET /api/v1/plugins.json      full plugin list

(the real contract is generated at build per §07 — this is a dev fixture)`;

const groups = [
  'MarkGlyph',
  'BracketBadge',
  'SiteHeader',
  'ThemeToggle',
  'SecondaryButton',
  'SelectedChip',
  'NavLink',
  'Footer',
  'Breadcrumbs',
  'SectionHeading',
  'Button',
  'SearchInput',
  'FilterBar',
  'EntryCard',
  'Chip',
  'FeaturedTag',
  'PromptBlock',
  'CopyButton',
  'AgentContractBlock',
  'TweetEmbed',
  'StatBar',
  'NewsletterRow',
  'Pagination',
  'RelatedList',
  'EmptyState',
  'Callout',
  'ContributeSteps',
  'InstallModal',
  'WallCard',
];
---

<BaseLayout
  title="component gallery — dev only"
  description="Dev-only component gallery. Never shipped to production."
  robots="noindex,nofollow"
>
  <div class="container-page flex flex-col gap-16 py-16">
    <header class="flex flex-col gap-4">
      <p class="font-mono text-xs lowercase text-text-muted">/dev/components/ · dev only</p>
      <h1 class="display-track font-display text-3xl text-text md:text-4xl">component gallery</h1>
      <p class="max-w-prose text-base text-text-muted">
        Every component in the §4.2 inventory, in every documented variant — plus the
        addendum-added components (A3 <code>MarkGlyph</code> variant system,
        A3 <code>BracketBadge</code>, B3 <code>InstallModal</code>, B2 <code>WallCard</code>).
        This page is <strong>noindex,nofollow</strong>, excluded from the sitemap, and
        excluded from production output. There is deliberately no sponsor-slot component (§1.7 / §12.6).
      </p>
      <nav aria-label="gallery contents" class="flex flex-wrap gap-2">
        {
          groups.map((group) => (
            <a
              href={`#c-${group.toLowerCase()}`}
              class="inline-flex min-h-6 items-center rounded-sm border border-border-interactive px-2 py-1 font-mono text-xs lowercase text-text-muted hover:border-accent hover:text-accent-text"
            >
              {group}
            </a>
          ))
        }
      </nav>
    </header>

    {/* ---------------------------------------------------------------- MarkGlyph */}
    <section id="c-markglyph" class="flex flex-col gap-6">
      <SectionHeading title="MarkGlyph — §4.2.1 + A3 variant system" />
      <p class="font-mono text-xs text-text-muted">
        variants: mark · logo · favicon · skeleton · divider · status. never the plain 3x3.
      </p>
      <div class="flex flex-wrap items-center gap-8">
        <figure class="flex flex-col items-center gap-2">
          <MarkGlyph variant="mark" size={24} class="text-text" />
          <figcaption class="font-mono text-xs text-text-muted">mark (default)</figcaption>
        </figure>
        <figure class="flex flex-col items-center gap-2">
          <MarkGlyph variant="mark" size={12} class="text-accent" />
          <figcaption class="font-mono text-xs text-text-muted">mark · 12px · accent</figcaption>
        </figure>
        <figure class="flex flex-col items-center gap-2">
          <MarkGlyph variant="logo" size={18} />
          <figcaption class="font-mono text-xs text-text-muted">logo (lockup)</figcaption>
        </figure>
        <figure class="flex flex-col items-center gap-2">
          <MarkGlyph variant="favicon" size={20} label="grokbot.dev" />
          <figcaption class="font-mono text-xs text-text-muted">favicon (tile)</figcaption>
        </figure>
        <figure class="flex flex-col items-center gap-2">
          <MarkGlyph variant="skeleton" size={24} />
          <figcaption class="font-mono text-xs text-text-muted">skeleton (loading)</figcaption>
        </figure>
        <figure class="flex flex-col items-center gap-2">
          <MarkGlyph variant="status" size={16} label="live" />
          <figcaption class="font-mono text-xs text-text-muted">status (pulse off)</figcaption>
        </figure>
        <figure class="flex flex-col items-center gap-2">
          <MarkGlyph variant="status" size={16} label="sweeping" pulse />
          <figcaption class="font-mono text-xs text-text-muted">
            status · pulse — POST-LAUNCH flag, ships OFF
          </figcaption>
        </figure>
      </div>
      <MarkGlyph variant="divider" size={14} />
      <p class="font-mono text-xs text-text-muted">divider (section motif)</p>
    </section>

    {/* -------------------------------------------------------------- BracketBadge */}
    <section id="c-bracketbadge" class="flex flex-col gap-6">
      <SectionHeading title="BracketBadge — A3 (built with grokbot.dev)" />
      <div class="flex flex-wrap items-center gap-4">
        <BracketBadge />
        <BracketBadge size="sm" />
        <BracketBadge variant="static" label="grokbot.dev" />
      </div>
    </section>

    {/* ----------------------------------------------------------------- SiteHeader */}
    <section id="c-siteheader" class="flex flex-col gap-4">
      <SectionHeading title="SiteHeader — §4.2.2" />
      <p class="text-base text-text-muted">
        Rendered once at the top of this page by <code>BaseLayout</code> — mark + wordmark,
        five nav links (incl. <code>wall</code> per B2), link-mode search, the ▪ /agent door,
        and the single solid submit Button. No variants; sticky is off.
      </p>
      <p class="text-base text-text-muted">
        <strong>Three responsive bands (F1/F2/F7, operator directive — supersedes §4.5's
        "no JS, no hamburger").</strong> Below <code>md</code>: one row, enlarged brand lockup
        (mark 26px, wordmark <code>--text-lg</code>) plus a 44×44 <code>menu</code> toggle;
        nav, search, /agent and submit move into a slide-in drawer. <code>md</code>–<code>lg</code>:
        one row with the full nav and the compact <code>search</code> link. From
        <code>lg</code>: unchanged, with the search input and the 18px mark.
      </p>
      <p class="text-base text-text-muted">
        <strong>The drawer</strong> is a native <code>&lt;details&gt;</code>, so it opens,
        closes and is keyboard-operable with zero JS — the island is enhancement only
        (§4.2.9's FilterBar shape): background scroll lock, focus trap, scrim tap, Escape,
        and the 280ms <code>translateX</code> slide, which is opted into via
        <code>data-nav-animate</code> so a no-JS visitor never gets a panel stranded
        off-screen. 80% width capped at 22rem, full height, internally scrollable with a
        token-coloured thin scrollbar, 24px padding, every target ≥44px, and the one
        <code>&lt;summary&gt;</code> serves as both the <code>menu</code> button and the
        <code>✕</code> pinned inside the panel's top-right. Honours
        <code>prefers-reduced-motion</code> by appearing instantly.
      </p>
    </section>

    {/* ----------------------------------------------------- button — secondary (slate) */}
    <section id="c-secondarybutton" class="flex flex-col gap-6">
      <SectionHeading title="button — secondary (slate) — F10(5)" />
      <p class="max-w-prose text-base text-text-muted">
        The section-level action that is <em>not</em> the amber primary. Filled with the A5
        slate family (<code>--color-cat-solid</code> on <code>--color-cat-on-solid</code>) so
        it reads as <strong>the</strong> action of its section while leaving A1's
        one-accent-per-viewport rule intact for the amber CTA.
      </p>
      <p class="max-w-prose text-base text-text-muted">
        ⚠️ <strong>Operator overrule, logged.</strong> A5 says slate is the ONLY taxonomy
        colour and nothing else; here it is doing action work. Directed by the operator at
        F10, recorded in BUILD-NOTES, and carried to the design authority.
        <strong>Deliberately scoped to this one control — do not generalise slate CTAs.</strong>
        Contrast is not waived: <code>cat-on-solid on cat-solid</code> is a gated pair in
        <code>check-contrast</code> (6.74:1 light · 8.30:1 dark).
      </p>
      <div class="flex flex-wrap items-center gap-6">
        <CopyButton text="secondary (slate) — rest / hover / copied" label="copy routine prompt" variant="slate" />
        <CopyButton text="ghost for comparison" label="copy" />
      </div>
      <p class="max-w-prose font-mono text-xs text-text-muted">
        States: rest (filled slate) · hover (brightness 0.92, border held) · copied (`copied ▪`
        stays on the filled tint, never inverting to an unreadable pair) · focus (global §4.6
        ring) · hidden until the copy island runs. 44px min height — it is a primary-weight
        target even though it is visually secondary.
      </p>
    </section>

    {/* ------------------------------------------------------- chip — selected (picker) */}
    <section id="c-selectedchip" class="flex flex-col gap-6">
      <SectionHeading title="chip — selected state — F10(4)" />
      <p class="max-w-prose text-base text-text-muted">
        The frequency picker's four options previously rendered identically whether chosen or
        not — only a faint border/text tint separated them, which read as "nothing is
        selected". The chosen chip is now <strong>filled and inverted</strong>
        (<code>--color-accent-strong</code> with <code>--color-accent-contrast</code>),
        unselected stay outline. Default remains <code>daily</code>.
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex min-h-6 items-center rounded-sm border border-accent-strong bg-accent-strong px-3 py-1 font-mono text-xs lowercase text-accent-contrast">
          daily — selected
        </span>
        <span class="inline-flex min-h-6 items-center rounded-sm border border-border-interactive px-3 py-1 font-mono text-xs lowercase text-text-muted">
          hourly — unselected
        </span>
      </div>
      <p class="max-w-prose font-mono text-xs text-text-muted">
        Driven by `peer-checked/*` off a visually-hidden radio, so selection is real form
        state and works with the island disabled.
      </p>
    </section>

    {/* --------------------------------------------------------------- ThemeToggle */}
    <section id="c-themetoggle" class="flex flex-col gap-6">
      <SectionHeading title="ThemeToggle — F9 (A1 dual mode)" />
      <p class="max-w-prose text-base text-text-muted">
        A1 requires dual mode with light as the default and a dark toggle. Until F9 every
        dark token in <code>tokens.css</code> was dead code: <code>[data-theme="dark"]</code>
        existed and nothing ever set it. This is the control that sets it — on
        <code>&lt;html&gt;</code>, persisted to <code>localStorage</code> under
        <code>gb-theme</code>.
      </p>
      <p class="max-w-prose text-base text-text-muted">
        <strong>The label names the mode you would switch TO</strong> — it reads
        <code>dark</code> while you are in light — because a control labelled with the state
        you are already in is the classic ambiguity. Both words are in the markup and
        <code>[data-theme]</code> chooses which one displays, so the label is CSS-driven, not
        script-driven: <code>public/theme-init.js</code> applies the stored theme before first
        paint, and a JS-written label would be briefly wrong on a repeat dark visit. It also
        means every instance on the page stays in sync with no bookkeeping.
      </p>
      <p class="max-w-prose text-base text-text-muted">
        <strong>Placements:</strong> desktop header right cluster (left of
        <code>submit</code>, so the one amber element keeps its prominence), inside the mobile
        drawer between the nav and the CTA, and the footer's bottom chrome bar — not the
        footer link columns, where a button reads as a broken link.
        <strong>prefers-color-scheme is deliberately not consulted</strong> (A1 says default
        light plus a toggle); only an explicit choice counts. No JS means light, which is that
        same default.
      </p>

      <div class="flex flex-col gap-4">
        <p class="font-mono text-xs lowercase text-text-muted">
          variants — `inline` (header, footer bar) and `chrome` (drawer, 44px floor)
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <ThemeToggle variant="inline" />
          <ThemeToggle variant="chrome" />
        </div>
        <p class="max-w-prose font-mono text-xs text-text-muted">
          States: rest (muted, interactive border) · hover (text + accent border) · active
          (1px translate, removed under prefers-reduced-motion) · focus (the global §4.6
          2px ring, never overridden here) · hidden until the island runs, because a control
          that cannot work is worse than no control.
        </p>
      </div>
    </section>

    {/* ------------------------------------------------------------------- NavLink */}
    <section id="c-navlink" class="flex flex-col gap-6">
      <SectionHeading title="NavLink — §4.2.3" />
      <div class="flex flex-wrap items-center gap-6">
        <NavLink href="/plugins/" label="header (default)" />
        <NavLink href="/plugins/" label="header (current)" current />
        <NavLink href="/plugins/" label="footer" variant="footer" />
        <NavLink href="https://github.com/ZeroPointRepo/GrokBotDev" label="external" external />
      </div>
    </section>

    {/* -------------------------------------------------------------------- Footer */}
    <section id="c-footer" class="flex flex-col gap-4">
      <SectionHeading title="Footer — §4.2.4" />
      <p class="text-base text-text-muted">
        Rendered once at the bottom of this page by <code>BaseLayout</code>: browse / machine /
        project columns, counts, and the full-width bottom line with the FENCED §10.5 disclaimer
        and the build stamp. The Footer never contains NewsletterRow (§9.1).
      </p>
    </section>

    {/* --------------------------------------------------------------- Breadcrumbs */}
    <section id="c-breadcrumbs" class="flex flex-col gap-6">
      <SectionHeading title="Breadcrumbs — §4.2.5" />
      <Breadcrumbs
        items={[
          { label: 'home', href: '/' },
          { label: 'plugins', href: '/plugins/' },
          { label: 'marketing', href: '/categories/marketing/' },
          { label: 'seo', href: '/categories/marketing/' },
          { label: 'seo-audit-bot' },
        ]}
      />
    </section>

    {/* ------------------------------------------------------------ SectionHeading */}
    <section id="c-sectionheading" class="flex flex-col gap-6">
      <SectionHeading title="SectionHeading — §4.2.6" />
      <SectionHeading title="default (h2, --text-2xl)" />
      <SectionHeading title="default + action" action={{ label: 'view all →', href: '/plugins/' }} />
      <SectionHeading title="sub (h3, --text-xl)" variant="sub" />
    </section>

    {/* -------------------------------------------------------------------- Button */}
    <section id="c-button" class="flex flex-col gap-6">
      <SectionHeading title="Button — §4.2.7" />
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="solid" label="solid · md" href="/submit/" />
        <Button variant="outline" label="outline · md" href="/plugins/" />
        <Button variant="ghost" label="ghost · md" href="/about/" />
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="solid" size="sm" label="solid · sm" href="/submit/" />
        <Button variant="outline" size="sm" label="outline · sm" href="/plugins/" />
        <Button variant="ghost" size="sm" label="ghost · sm" href="/about/" />
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="outline" label="button element" type="button" />
        <Button variant="outline" label="disabled" type="button" disabled />
        <Button variant="outline" label="external" href="https://x.com/" external />
      </div>
    </section>

    {/* --------------------------------------------------------------- SearchInput */}
    <section id="c-searchinput" class="flex flex-col gap-6">
      <SectionHeading title="SearchInput — §4.2.8" />
      <p class="font-mono text-xs text-text-muted">mode: link (zero JS, GET → /search/)</p>
      <SearchInput mode="link" />
      <p class="font-mono text-xs text-text-muted">
        mode: link, pre-scoped (submits q + type=plugin)
      </p>
      <SearchInput mode="link" hiddenFields={{ type: 'plugin' }} />
      <p class="font-mono text-xs text-text-muted">
        mode: page (Pagefind island + noscript fallback) — index exists only after a full build
      </p>
      <SearchInput mode="page" initialQuery="" />
    </section>

    {/* ----------------------------------------------------------------- FilterBar */}
    <section id="c-filterbar" class="flex flex-col gap-6">
      <SectionHeading title="FilterBar — §4.2.9" />
      <p class="font-mono text-xs text-text-muted">facets: category + integration (lane index)</p>
      <FilterBar
        facets={['category', 'integration']}
        options={facetOptions}
        clearHref="/plugins/"
      />
      <p class="font-mono text-xs text-text-muted">facets: category only (/collections/)</p>
      <FilterBar facets={['category']} options={facetOptions} clearHref="/collections/" />
      <p class="font-mono text-xs text-text-muted">facets: all three (/search/)</p>
      <FilterBar
        facets={['category', 'integration', 'type']}
        options={facetOptions}
        clearHref="/search/"
      />
    </section>

    {/* ----------------------------------------------------------------- EntryCard */}
    <section id="c-entrycard" class="flex flex-col gap-6">
      <SectionHeading title="EntryCard — §4.2.10" />
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-6">
        <EntryCard entry={samplePlugin} variant="plugin" />
        <EntryCard entry={sampleUseCase} variant="use-case" />
        <EntryCard
          entry={sampleCollection}
          variant="collection"
          memberCounts={{ plugins: 3, useCases: 1 }}
        />
      </div>
      <p class="font-mono text-xs text-text-muted">
        featured · needs-update · hub mode (type chip rendered)
      </p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-6">
        <EntryCard entry={samplePlugin} variant="plugin" featured />
        <EntryCard entry={staleUseCase} variant="use-case" />
        <EntryCard entry={samplePlugin} variant="plugin" showType />
      </div>
    </section>

    {/* ---------------------------------------------------------------------- Chip */}
    <section id="c-chip" class="flex flex-col gap-6">
      <SectionHeading title="Chip — §4.2.11 + A5" />
      <div class="flex flex-wrap items-center gap-2">
        <Chip variant="verified" date="2026-08-21" />
        <Chip variant="setup-time" label="~5 min setup" />
        <Chip variant="category" label="Marketing" href="/categories/marketing/" />
        <Chip variant="integration" label="Google Calendar" href="/integrations/gmail/" />
        <Chip variant="scouted" label="scouted on x" href="https://x.com/example/status/1" />
        <Chip variant="scouted" label="scouted on x" />
      </div>
      <p class="font-mono text-xs text-text-muted">
        A5 type axis — shape, never hue: plugin (filled) · use-case (outline) · collection (dashed)
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <Chip variant="type" label="plugin" entryType="plugin" href="/plugins/" />
        <Chip variant="type" label="use case" entryType="use-case" href="/use-cases/" />
        <Chip variant="type" label="collection" entryType="collection" href="/collections/" />
      </div>
      <p class="font-mono text-xs text-text-muted">active filter chip (removeHref)</p>
      <div class="flex flex-wrap items-center gap-2">
        <Chip variant="category" label="Marketing" removeHref="/plugins/" />
      </div>
    </section>

    {/* ---------------------------------------------------------------- FeaturedTag */}
    <section id="c-featuredtag" class="flex flex-col gap-6">
      <SectionHeading title="FeaturedTag — §4.2.12" />
      <div class="relative max-w-sm rounded-sm border border-border bg-surface p-4">
        <FeaturedTag />
        <p class="text-base text-text-muted">
          square-cornered corner mark — the one deliberate radius break
        </p>
      </div>
      <div class="relative max-w-sm rounded-sm border border-border bg-surface p-4">
        <FeaturedTag label="editor's pick" />
        <p class="text-base text-text-muted">custom label</p>
      </div>
    </section>

    {/* --------------------------------------------------------------- PromptBlock */}
    <section id="c-promptblock" class="flex flex-col gap-6">
      <SectionHeading title="PromptBlock — §4.2.13" />
      <PromptBlock prompt={samplePlugin.prompt ?? ''} />
      <p class="font-mono text-xs text-text-muted">clamped preview (maxLines 12 + view full)</p>
      <PromptBlock
        prompt={`${samplePlugin.prompt}\n\n${sampleCollection.prompt}`}
        maxLines={4}
        viewFullHref="/plugins/"
      />
    </section>

    {/* ---------------------------------------------------------------- CopyButton */}
    <section id="c-copybutton" class="flex flex-col gap-6">
      <SectionHeading title="CopyButton — §4.2.14" />
      <p class="font-mono text-xs text-text-muted">
        states are runtime: idle → copied ▪ (2000ms) → idle; error → press ctrl+c
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <CopyButton text="copied from the dev gallery" />
        <CopyButton text="copied from the dev gallery" label="copy contract" size="md" />
      </div>
    </section>

    {/* -------------------------------------------------------- AgentContractBlock */}
    <section id="c-agentcontractblock" class="flex flex-col gap-6">
      <SectionHeading title="AgentContractBlock — §4.2.15" />
      <AgentContractBlock contractMarkdown={contractMarkdown} />
    </section>

    {/* ---------------------------------------------------------------- TweetEmbed */}
    <section id="c-tweetembed" class="flex flex-col gap-6">
      <SectionHeading title="TweetEmbed — §4.2.16" />
      <p class="font-mono text-xs text-text-muted">
        unloaded = default and permanent until a click. zero third-party requests before then.
      </p>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
        <TweetEmbed
          tweetUrl={sampleUseCase.sourceTweets[0].url}
          authorHandle={sampleUseCase.sourceTweets[0].authorHandle}
          excerpt={sampleUseCase.sourceTweets[0].excerpt}
          postedAt={sampleUseCase.sourceTweets[0].postedAt}
        />
        <TweetEmbed
          tweetUrl="https://x.com/example/status/1000000000000000002"
          authorHandle="example"
          excerpt="second embed on the same page reuses the already-loaded widgets.js — it is injected once, and only after a click."
        />
      </div>
    </section>

    {/* ------------------------------------------------------------------- StatBar */}
    <section id="c-statbar" class="flex flex-col gap-6">
      <SectionHeading title="StatBar — §4.2.17" />
      <p class="font-mono text-xs text-text-muted">variant: full (home)</p>
      <StatBar stats={stats} variant="full" />
      <p class="font-mono text-xs text-text-muted">variant: inline (hub pages)</p>
      <StatBar stats={stats} variant="inline" />
      <p class="font-mono text-xs text-text-muted">
        inline, hub scope — plugins + use cases only, no collection count (§6.2)
      </p>
      <StatBar stats={stats} variant="inline" hideCollections />
    </section>

    {/* ------------------------------------------------------------- NewsletterRow */}
    <section id="c-newsletterrow" class="flex flex-col gap-6">
      <SectionHeading title="NewsletterRow — §4.2.18" />
      <NewsletterRow source="home" />
      <p class="font-mono text-xs text-text-muted">custom heading/subcopy (props)</p>
      <NewsletterRow
        source="plugin-detail"
        heading="the week's best, in one email"
        subcopy="new plugins, use cases and collections. one email a week. that's it."
      />
    </section>

    {/* ---------------------------------------------------------------- Pagination */}
    <section id="c-pagination" class="flex flex-col gap-6">
      <SectionHeading title="Pagination — §4.2.19" />
      <Pagination
        page={{ current: 1, total: 6, nextUrl: '/plugins/', baseUrl: '/plugins/' }}
      />
      <Pagination
        page={{
          current: 3,
          total: 6,
          prevUrl: '/plugins/',
          nextUrl: '/plugins/',
          baseUrl: '/plugins/',
        }}
      />
      <Pagination page={{ current: 6, total: 6, prevUrl: '/plugins/', baseUrl: '/plugins/' }} />
    </section>

    {/* --------------------------------------------------------------- RelatedList */}
    <section id="c-relatedlist" class="flex flex-col gap-6">
      <SectionHeading title="RelatedList — §4.2.20" />
      <RelatedList entries={[samplePlugin, sampleUseCase]} />
      <RelatedList entries={[sampleCollection]} variant="appears-in" />
      <p class="font-mono text-xs text-text-muted">
        empty → renders nothing at all (no empty related/appears-in sections, ever):
      </p>
      <RelatedList entries={[]} />
    </section>

    {/* ---------------------------------------------------------------- EmptyState */}
    <section id="c-emptystate" class="flex flex-col gap-6">
      <SectionHeading title="EmptyState — §4.2.21" />
      <div class="rounded-sm border border-border">
        <EmptyState variant="search" query="slack" />
      </div>
      <div class="rounded-sm border border-border">
        <EmptyState variant="hub" />
      </div>
      <div class="rounded-sm border border-border">
        <EmptyState
          variant="generic"
          heading="404 — not found"
          body="this page doesn't exist. the bots have been notified. (they haven't. it's a static site.)"
          action={{ label: 'home', href: '/' }}
        />
      </div>
    </section>

    {/* ------------------------------------------------------------------- Callout */}
    <section id="c-callout" class="flex flex-col gap-6">
      <SectionHeading title="Callout — §4.2.22" />
      <Callout variant="info" title="humans">you probably want /plugins/ instead</Callout>
      <Callout variant="warn" title="needs update">
        {fillCopy(CP_067_CALLOUT_NEEDS_UPDATE, { verified_at: '2026-05-02' })}
      </Callout>
      <Callout variant="danger" title="deprecated">{CP_068_CALLOUT_DEPRECATED}</Callout>
      <Callout variant="info" title="what you need">
        works on any Grok plan with calendar + gmail connected. no code.
      </Callout>
    </section>

    {/* ----------------------------------------------------------- ContributeSteps */}
    <section id="c-contributesteps" class="flex flex-col gap-6">
      <SectionHeading title="ContributeSteps — §4.2.23" />
      <ContributeSteps
        steps={[
          {
            title: 'fork ZeroPointRepo/GrokBotDev',
            body: 'one public repo, one markdown file per entry.',
            code: 'gh repo fork ZeroPointRepo/GrokBotDev',
          },
          {
            title: 'add your entry file',
            body: 'content/plugins/<slug>.md — the schema lives in the repo README.',
          },
          {
            title: 'open the PR',
            body: 'CI checks it. we verify it. merged = live in minutes.',
          },
        ]}
      />
      <p class="font-mono text-xs text-text-muted">startAt = 4 (reused as a generic step list)</p>
      <ContributeSteps
        startAt={4}
        steps={[{ title: 'set the schedule', body: 'daily is the default and the right default.' }]}
      />
    </section>

    {/* --------------------------------------------------------------- InstallModal */}
    <section id="c-installmodal" class="flex flex-col gap-6">
      <SectionHeading title="InstallModal — Addendum B3" />
      <p class="font-mono text-xs text-text-muted">
        entry variant (prompt) · entry variant (install steps) · site variant (section 2 first)
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <InstallModal
          id="demo-entry"
          variant="entry"
          prompt={samplePlugin.prompt}
          entryName={samplePlugin.name}
        />
        <InstallModal
          id="demo-steps"
          variant="entry"
          installSteps={samplePlugin.installSteps}
          entryName={samplePlugin.name}
          triggerLabel="install in grok bot (steps)"
        />
        <InstallModal id="site" variant="site" />
      </div>
    </section>

    {/* -------------------------------------------------------------------- WallCard */}
    <section id="c-wallcard" class="flex flex-col gap-6">
      <SectionHeading title="WallCard — Addendum B2" />
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
        <WallCard
          tweet={sampleUseCase.sourceTweets[0]}
          entryName={sampleUseCase.name}
          entryHref="/use-cases/"
        />
      </div>
    </section>

    <p class="font-mono text-xs text-text-muted">
      no sponsor-slot component exists — §1.7 / §12.6: do not build even a stub.
    </p>
  </div>
</BaseLayout>
