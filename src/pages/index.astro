---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="grokbot.dev" description="A community directory for what Grok Bot can do.">
  <section class="container-page py-24 md:py-32" data-pagefind-body>
    <p class="mb-4 font-mono text-sm text-text-muted">community index</p>
    <h1 class="display-track max-w-4xl font-display text-4xl font-semibold text-text md:text-5xl">
      Everything your Grok Bot could be doing
    </h1>
    <p class="mt-6 max-w-2xl text-base text-text-muted md:text-lg">
      The base layout is live: header, rails-ready page shell, and footer chrome are wired to the M0 token system.
    </p>
  </section>
</BaseLayout>
