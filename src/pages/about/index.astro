---
// §4.3.14 — /about/: the engine story, the independence disclaimer prominently (§10.5,
// FENCED CP-110), the CRHQ cross-link and StatBar full. A7 comms rules bind this page:
// Scouts / the Curator / the Builder, and "always on" — never a cadence.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Callout from '../../components/Callout.astro';
import StatBar from '../../components/StatBar.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NewsletterRow from '../../components/NewsletterRow.astro';
import { siteStats } from '../../lib/entries';
import {
  CP_110_DISCLAIMER,
  CP_119_ABOUT_PRIVACY_ANALYTICS,
  CP_120_ABOUT_PRIVACY_EMBEDS,
  CP_120_MONO_TOKEN,
} from '../../lib/copy';
import { META, breadcrumbList, webPage } from '../../lib/seo';

const stats = await siteStats();
const crumbs = [{ label: 'home', href: '/' }, { label: 'about' }];
const graph = [webPage('/about/', META.about.title, META.about.description), breadcrumbList(crumbs)];

// CP-120 is §16 PROTECTED, so the markup splits the one mono-rendered token OUT of the string
// rather than re-typing the sentence around it. The constant stays the single source.
const [privacyEmbedsBefore, privacyEmbedsAfter] = CP_120_ABOUT_PRIVACY_EMBEDS.split(CP_120_MONO_TOKEN);
---

<BaseLayout title={META.about.title} description={META.about.description} graph={graph}>
  <div class="container-page flex flex-col gap-12 py-12 md:py-16">
    <header class="flex flex-col gap-4">
      <Breadcrumbs items={crumbs} />
      <h1 class="display-track font-display text-3xl text-text md:text-4xl">About</h1>
      <p class="max-w-prose text-base text-text-muted">
        grokbot.dev is a directory of what people actually get their Grok Bot to do — kept
        current by a small team of bots, in the open.
      </p>
    </header>

    <StatBar stats={stats} variant="full" />

    <section class="flex max-w-prose flex-col gap-4">
      <SectionHeading title="who keeps it current" variant="sub" level={2} />
      <p class="text-base text-text-muted">
        The <strong>Scouts</strong> watch X for people posting real setups. The
        <strong>Curator</strong> decides what earns a page and pairs entries into collections.
        The <strong>Builder</strong> maintains the site itself. They are always on, and every
        change they make arrives as a pull request you can read.
      </p>
      <p class="text-base text-text-muted">
        Nothing gets a verification date unless a maintainer — or the Curator — has actually
        read it. If an entry is stale, it says so on the page.
      </p>
    </section>

    <section class="flex max-w-prose flex-col gap-4">
      <SectionHeading title="who built it" variant="sub" level={2} />
      <p class="text-base text-text-muted">
        grokbot.dev is built and run by{' '}
        <a
          href="https://crhq.ai"
          target="_blank"
          rel="noopener"
          class="text-text underline underline-offset-4 hover:text-accent-text"
        >
          CRHQ
        </a>, which builds and operates products like this one. The site is open source and
        the whole history is public — every entry arrived as a pull request you can read.
      </p>
    </section>

    <section id="privacy" class="flex max-w-prose flex-col gap-4">
      <SectionHeading title="privacy" variant="sub" level={2} />
      {/* CP-119 + CP-120 — §16 PROTECTED. Do not reword here; the strings live in lib/copy.ts
          and any change is a copy-governance change, not a polish edit. */}
      <p class="text-base text-text-muted">{CP_119_ABOUT_PRIVACY_ANALYTICS}</p>
      <p class="text-base text-text-muted">
        {privacyEmbedsBefore}<span class="font-mono text-sm">{CP_120_MONO_TOKEN}</span>{privacyEmbedsAfter}
      </p>
    </section>

    <Callout variant="info" title="independence">{CP_110_DISCLAIMER}</Callout>

    <NewsletterRow source="home" />
  </div>
</BaseLayout>
