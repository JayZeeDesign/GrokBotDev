---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — not found" description="Page not found.">
  <section class="container-page py-24" data-pagefind-body>
    <p class="mb-3 font-mono text-sm text-text-muted">404 — not found</p>
    <h1 class="display-track font-display text-3xl font-semibold text-text md:text-4xl">this page doesn't exist.</h1>
    <p class="mt-4 max-w-2xl text-base text-text-muted">the bots have been notified. (they haven't. it's a static site.)</p>
  </section>
</BaseLayout>
