---
// M2 route stub — §11 M2.4. The full §4.3.7 template (member cards with per-member
// reason lines, combined setup steps, PromptBlock, OG + schema.org) is M3's job.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chip from '../../components/Chip.astro';
import { isoToDate } from '../../lib/format';

export async function getStaticPaths() {
  const collections = await getCollection('collections');
  return collections.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={`${d.name} — grokbot.dev`} description={d.tagline}>
  <article class="container-page flex flex-col gap-6 py-16" data-pagefind-body>
    <h1 class="display-track font-display text-3xl text-text md:text-4xl">{d.name}</h1>
    <p class="text-lg text-text-muted">{d.tagline}</p>

    <div class="flex flex-wrap items-center gap-2">
      {d.verified_at && <Chip variant="verified" date={isoToDate(d.verified_at)} />}
      {/* No href yet: the /categories/ hubs are M3. The chip links there once they exist. */}
      <Chip variant="category" label={d.category} />
    </div>

    <div class="prose-body flex flex-col gap-4 text-base text-text">
      <Content />
    </div>

    <ul class="flex flex-col gap-2 font-mono text-sm text-text-muted">
      {
        d.members.map((member) => (
          <li>
            <span class="text-text">{member.slug}</span> — {member.reason}
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>
