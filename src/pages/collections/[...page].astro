---
// §4.3.6 `/collections/` + `/collections/<n>/`. Collection cards are wider — 2-col at lg
// (§4.5); the shared lane grid handles the rest.
// Copy: CP-036 h1 `Collections` (§6.3, C3.3) · CP-037 intro (A7 naming: "the Curator",
// never "the bots").
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LaneIndexPage from '../../components/LaneIndexPage.astro';
import { allCollections, sortForIndex, urlOf } from '../../lib/entries';
import type { AnyDoc } from '../../lib/entries';
import { META, breadcrumbList, collectionPage, itemList, paginate } from '../../lib/seo';

export const getStaticPaths = (async ({ paginate: paginateFn }) => {
  const collections = sortForIndex(await allCollections());
  return paginateFn(collections, { pageSize: 24 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<AnyDoc> };
const pool = sortForIndex(await allCollections());

const meta = paginate(META.collections, page.currentPage, page.lastPage);
const url = page.currentPage === 1 ? '/collections/' : `/collections/${page.currentPage}/`;
const crumbs = [{ label: 'home', href: '/' }, { label: 'collections' }];
const graph = [
  collectionPage(url, meta.title, meta.description),
  breadcrumbList(crumbs),
  itemList(page.data.map((entry) => ({ url: urlOf(entry), name: entry.data.name }))),
];
---

<BaseLayout title={meta.title} description={meta.description} graph={graph}>
  <LaneIndexPage
    h1="Collections"
    intro="whole setups, not single prompts. the Curator pairs them up."
    entries={page.data}
    page={page}
    baseUrl="/collections/"
    variant="collection"
    facets={['category']}
    source="collections-index"
    pool={pool}
    laneLabel="collections"
  />
</BaseLayout>
