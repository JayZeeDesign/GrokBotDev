---
// §4.2.2 SiteHeader — global header. Sticky is OFF (static, scrolls away), 1px bottom
// border, background --color-bg (not surface). NO Stats link in the header: Stats lives
// in the footer only (§4.2.4, §9.9).
// Nav: plugins · use cases · collections · builder bot · wall — B2 adds /wall/ to the
// header nav (mono, lowercase). Right cluster: SearchInput link-mode, the /agent door
// (leading ▪ at 8px — the one place "agent" appears in the UI), and the one solid
// Button → /submit/.
//
// ── F1/F2 (operator, Stage 5B) — SUPERSEDES §4.5's "no JS, no hamburger" nav collapse.
// The wrap-everything header stacked into THREE rows on a phone and ate the fold; the
// operator's verdict was "much less busy". So: below the breakpoint the whole menu lives in
// a slide-in drawer behind one `menu` toggle, and above it the full inline row shows.
//
// ── THE BOUNDARY IS `lg` (1024), NOT `md` (768) — moved 2026-08-30. ─────────────────────
// F1 originally drew that line at `md`, and that was correct for a THREE-link nav. The nav
// has since grown to five (shareable bots · use cases · collections · wall · news) and the
// right cluster grew too (/agent · theme · submit · `connect your bot`). Measured: those
// eight items plus their gutters do not fit one row until ~1024px, so the 768–1023 band was
// wrapping the header into three and four cramped rows — the exact failure F1 was written to
// kill, returning through the back door as the nav grew.
//
// The fix is deliberately the FUTURE-PROOF one rather than a per-item squeeze (shorter
// labels, tighter gaps, dropping a link at tablet): the boundary moves to `lg`, so
//
//   < lg (<1024) : ONE row — brand lockup left, then theme · `connect` · `menu` at the right
//                  edge. The ENTIRE nav plus /agent, submit and connect live in the drawer.
//   ≥ lg (1024)  : the full inline row — brand + all nav + /agent + theme + submit + connect
//                  — on a single line, with the roomy gap-x-8 / min-h-16 / py-4 treatment.
//
// The drawer is the deliberate home for a growing nav: its panel is `overflow-y: auto` with
// `overscroll-behavior: contain`, so link six, ten and twenty cost nothing but scroll — the
// inline row is the fragile surface, the drawer is the elastic one. When the nav next grows,
// nothing here needs to change; only the ≥lg row needs re-measuring. Tablet users lose
// nothing: ONE `nav` array feeds both surfaces, so the drawer always has every link the
// inline row has.
//
// §4.5 pins breakpoints to the Tailwind defaults "used exclusively", so this is `lg` (1024)
// — a sanctioned breakpoint — and not an arbitrary measured value like 990px, which the
// §8.5 check-13 arbitrary-value grep would reject anyway. Every md→lg swap in this file is
// ONE decision: nav, right cluster, mobile ThemeToggle, `.headerConnect`, `.navDrawer` (both
// the utility and its scoped media query), the brand's `flex-none`, the container's
// gap/height/padding step-up, and the island's resize threshold all move together. Changing
// one without the others reintroduces the wrap.
//
// The drawer is a native `<details>`: it opens, closes and is keyboard-operable with ZERO
// JS. The island below is ENHANCEMENT ONLY (scroll lock, focus trap, scrim tap, Escape),
// exactly the shape §4.2.9 already sanctions for FilterBar, so §4.4 rule 7 holds — no
// JS-dependent interaction is load-bearing.
// ── Surface 1 of the "connect to THE FEED" system (operator, 2026-08-22) ────────────────
// The header now carries the persistent entry point to `#install-site` — the ONE feed panel
// BaseLayout renders sitewide. It is a real anchor with `data-install-trigger`, so it opens
// the panel through the island with JS and through `:target` without it.
//
// §A1 ACCENT SWAP, not an accent ADDITION. The header's one amber element used to be
// `submit`; it is now `connect your bot`, and `submit` drops to the muted NavLink treatment
// the /agent door already uses. Net amber count per viewport is unchanged at exactly one, in
// all three header contexts (≥md cluster · <md bar · drawer). If you are tempted to give
// `submit` its fill back, that is a §A1 decision, not a styling one.
import MarkGlyph from './MarkGlyph.astro';
import NavLink from './NavLink.astro';
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';
import { CP_126_CONNECT_HEADER, CP_127_CONNECT_SHORT, CP_148_MARKETPLACE_NAV } from '../lib/copy';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// F11 — operator: "Just keep the wall." plugins / use cases / collections / builder bot and
// the header SEARCH are all removed from chrome at every viewport. Those routes still BUILD
// and stay in the sitemap; they are unlinked from the header only.
// SEO note (BUILD-NOTES): every hub keeps at least one internal link path — entry
// breadcrumbs link `/plugins/`, `/use-cases/` and `/collections/` (F14), the footer's browse
// column links all of them plus `/categories/` and `/integrations/`, and the home table's
// category chips link the category hubs. Nothing is orphaned.
// Operator (2026-08-28): Shareable Bots joins the nav. One array feeds BOTH the >=md row and
// the mobile drawer, so a third item cannot arrive in one and not the other.
// Operator (2026-08-28): `use cases` joins the nav because the home page no longer carries an
// Awesome Use Cases tab. /use-cases/ is untouched; only its route INTO the site moved.
const nav = [
  { href: '/marketplace/', label: CP_148_MARKETPLACE_NAV },
  { href: '/use-cases/', label: 'use cases' },
  { href: '/collections/', label: 'collections' },
  { href: '/wall/', label: 'wall' },
  { href: '/news/', label: 'news' },
];
---

<header class="siteHeader border-b border-border bg-bg" data-pagefind-ignore>
  {/* `gap-x-2` below lg, the original `gap-x-8` from lg up. The <lg bar carries FOUR controls
      (brand · theme · connect · menu) and the numbers are genuinely tight: measured at 390px
      the four intrinsic widths total 315px against 358px of content box, so a 32px gutter
      between them wrapped `menu` onto a second row — the exact three-row failure F1 was
      written to kill. 8px holds the row at 360px and up. See `.headerConnect` and the
      narrow-phone block below for the other two thirds of the fit.
      The min-h/gap/py step-up rides the SAME boundary as the inline nav (md→lg, 2026-08-30):
      the roomy 64px row is sized for the full desktop cluster, so it belongs only where that
      cluster shows. The 768–1023 band now renders the same compact four-control bar as a
      phone and gets the compact 48px treatment with it — one bar, one set of numbers. */}
  <div class="container-page flex min-h-12 flex-wrap items-center gap-x-2 gap-y-4 py-2 lg:min-h-16 lg:gap-x-8 lg:py-4">
    {/* `flex-1` only below lg, where it is what pushes the drawer toggle to the right edge.
        From lg up the brand must shrink to its content or it steals width from the nav and
        forces a second row — measured at F1 QA. This tracks the nav's boundary exactly: if it
        stayed at md the brand would stop growing at 768 while the drawer still owned that
        band, leaving a gap between the lockup and the right-edge controls. */}
    <a href="/" class="brand flex flex-1 items-center gap-3 lg:flex-none" aria-label="grokbot.dev home">
      {/* Direct round: mark is INK (grid) + the amber accent dot from grid() itself.
          `text-accent` here painted the WHOLE grid amber — part of "logo icon is off". */}
      <MarkGlyph size={30} class="brand-mark text-text" />
      <span class="brand-word display-track font-display font-semibold lowercase text-text">
        grokbot.dev
      </span>
    </a>

    <nav class="hidden flex-1 flex-wrap items-center gap-x-6 gap-y-2 lg:flex" aria-label="main">
      {nav.map((item) => <NavLink href={item.href} label={item.label} current={isCurrent(item.href)} />)}
    </nav>

    <div class="hidden flex-wrap items-center gap-x-6 gap-y-2 lg:flex">
      <span class="inline-flex items-center gap-1">
        <span aria-hidden="true" class="agent-glyph text-accent">▪</span>
        <NavLink href="/agent/" label="/agent" current={isCurrent('/agent/')} />
      </span>

      {/* F9 — sits with the other chrome, left of the one amber element, which keeps
          A1's "one accent per viewport" position of prominence at the end of the row. */}
      <ThemeToggle variant="inline" />

      {/* Demoted from `Button variant="solid"` — same link treatment as /agent above. */}
      <NavLink href="/submit/" label="submit" current={isCurrent('/submit/')} />

      <Button
        href="#install-site"
        variant="solid"
        size="sm"
        label={CP_126_CONNECT_HEADER}
        attrs={{ 'data-install-trigger': 'install-site' }}
      />
    </div>

    {/* ── the slide-in drawer (below lg). Native <details>; the island only enhances it. ──
        F7: spacing is expressed as Tailwind utilities, NOT as `var(--spacing-N)` in the
        scoped CSS. Tailwind v4 defines a single `--spacing` multiplier and computes
        `calc(var(--spacing) * n)` inside each utility — it never emits `--spacing-6`, so my
        first cut's `padding: var(--spacing-6)` resolved to nothing and the drawer shipped
        with no padding at all. That is exactly what the operator saw. Utilities can't
        silently evaluate to nothing. */}
    {/* Direct round: light/dark is VISIBLE in the drawer-band header now, not inside the
        drawer — moved, not duplicated. The wrapper (not the button) carries `lg:hidden`,
        because the button's scoped `.themeToggle{display:inline-flex}` outranks the utility
        and would keep it visible at desktop otherwise. `lg`, not `md`: it must disappear
        exactly where the ≥lg cluster's own ThemeToggle appears, or the 768–1023 band would
        show two of them. */}
    <span class="lg:hidden inline-flex"><ThemeToggle variant="inline" /></span>

    {/* The <lg CTA rides in the BAR, not only in the drawer: an action worth putting in
        every header is worth reaching without opening a menu first. It carries CP-127
        (`connect`) rather than CP-126 — measured at 360/375px, the long label is wider than
        the row can give it beside the brand, the theme toggle and `menu`, and F1's whole
        point was that this header stays ONE row on a phone. Display is switched in the
        scoped CSS below, the way `.navDrawer` does it: a scoped `display: inline-flex`
        outranks a `lg:hidden` utility, which is the trap the ThemeToggle note above
        describes. */}
    <a href="#install-site" data-install-trigger="install-site" class="headerConnect">
      {CP_127_CONNECT_SHORT}
    </a>

    <details class="navDrawer lg:hidden" data-nav-drawer>
      <summary class="navDrawer__toggle" aria-label="menu">
        <span class="navDrawer__word navDrawer__word--closed">menu</span>
        <span class="navDrawer__word navDrawer__word--open" aria-hidden="true">✕</span>
      </summary>

      {/* Tap-outside target. Enhancement only — without JS you close with the same control. */}
      <span class="navDrawer__scrim" data-nav-scrim aria-hidden="true"></span>

      <div
        class="navDrawer__panel flex flex-col gap-8 p-6 pt-20"
        data-nav-panel
        tabindex="-1"
        role="group"
        aria-label="site menu"
      >
        <nav class="navDrawer__nav flex flex-col gap-1" aria-label="mobile">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'navDrawer__link',
                isCurrent(item.href) && 'navDrawer__link--current',
              ]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}

          <span class="navDrawer__rule my-3" aria-hidden="true"></span>

          <a
            href="/agent/"
            class:list={['navDrawer__link', isCurrent('/agent/') && 'navDrawer__link--current']}
            aria-current={isCurrent('/agent/') ? 'page' : undefined}
          >
            <span aria-hidden="true" class="agent-glyph text-accent">▪</span> /agent
          </a>

          {/* Demoted here too, for the same reason and by the same rule. */}
          <a
            href="/submit/"
            class:list={['navDrawer__link', isCurrent('/submit/') && 'navDrawer__link--current']}
            aria-current={isCurrent('/submit/') ? 'page' : undefined}
          >
            submit
          </a>
        </nav>

        {/* A1 accent law: connect is the ONE amber element in the drawer. */}
        <a href="#install-site" data-install-trigger="install-site" class="navDrawer__cta">
          {CP_126_CONNECT_HEADER}
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  /* §4.2.2 — the machine door is marked with an 8px ▪ glyph. */
  .agent-glyph {
    font-size: 8px;
    line-height: 1;
  }

  /* F2 — the phone lockup was too small next to the nav type. The mark ships at 26px and
     steps back to the desktop 18px at lg; the wordmark rides with it (--text-lg → --text-sm).
     `!important` is load-bearing here and nowhere else: §4.2.1 MarkGlyph writes its size as
     an INLINE style, which no class can outrank. Changing that documented prop API for one
     caller would be the bigger change. */
  /* `:global()` is required, not stylistic: the mark is rendered by the MarkGlyph CHILD
     component, so it never receives this component's scope attribute and a plain
     `.brand-mark` selector silently matches nothing. `.brand-word` is in this template and
     scopes normally. Caught at F2 QA — the lg step-down was a no-op without it. */
  /* Direct round — operator: "it needs to be much larger in the header." One size at every
     width now: 30px mark, --text-xl wordmark from lg (mobile keeps --text-lg for fit). The
     F15 lg step-DOWN is gone — it was the wrong direction. */
  :global(.brand-mark) {
    inline-size: 30px !important;
    block-size: 30px !important;
  }
  .brand-word {
    font-size: var(--text-lg);
  }
  @media (min-width: 1024px) {
    .brand-word {
      font-size: var(--text-xl);
    }
  }

  /* ---------- the <lg connect pill (Surface 1) ---------- */
  /* Sized to sit level with the `menu` toggle — same 36px block size, same radius, same mono
     — so the bar reads as two controls of one family rather than a CTA bolted onto a header.
     36px is the height the operator already settled on for `menu` (down from 44) and it
     clears SC 2.5.8's 24px floor with room; matching it beats re-litigating that decision on
     the button next to it. `margin-inline-start: auto` is deliberately NOT set here — the
     drawer carries it, so the pill sits immediately left of `menu` at the right edge. */
  .headerConnect {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-block-size: 36px;
    /* --text-xs + 8px of inline padding is the smallest this can be and still read as a
       button. It is the §4.2.7 `sm` button's type size; the padding is tighter than that
       spec's 12px because the bar has 43px of slack at 390 and none at 360. */
    padding-inline: 0.5rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: var(--radius-sm);
    background: var(--color-accent-strong);
    color: var(--color-accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: lowercase;
    white-space: nowrap;
  }
  .headerConnect:hover {
    filter: brightness(0.9);
  }
  .headerConnect:active {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .headerConnect:active {
      transform: none;
    }
  }
  /* From lg the ≥lg cluster owns the CTA (with the long CP-126 label), so this one goes.
     1024, not 768 (2026-08-30): this pill is the bar's ONE amber element, and the bar now
     runs to 1023. Handing the CTA over at 768 would leave the 768–1023 band with no accent
     at all and no connect entry point outside the drawer. */
  @media (min-width: 1024px) {
    .headerConnect {
      display: none;
    }
  }

  /* ---------- narrow-phone fit (≤389px: 360, 375, 384 …) ----------
     The last 8px. Below 390 the four controls plus their gutters run past the content box
     and `menu` drops to a second row, so the LOCKUP gives back what the new control takes:
     the mark stays at its full 30px (the operator's "much larger in the header" was about
     the mark, and it is untouched) and only the wordmark steps --text-lg → --text-base with
     a tighter mark/word gap. Measured 360px: 127 + 50 + 68 + 55 + 24 = 324 against 328.
     This is a FIT rule with a reason, not a taste rule — if the bar ever loses a control,
     delete it rather than keeping a smaller wordmark for no cause. */
  @media (max-width: 389px) {
    .brand {
      gap: 0.5rem;
    }
    .brand-word {
      font-size: var(--text-base);
    }
  }

  /* ---------- drawer (F1, polished at F7) ---------- */
  .navDrawer {
    margin-inline-start: auto;
  }

  /* The ONE control: `menu` in the header when closed, `✕` inside the panel when open.
     Keeping it as the <summary> means the drawer still opens and closes with zero JS — a
     second, JS-only close button would be a control that silently does nothing. */
  .navDrawer__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Direct round: slimmed from 44px — the header was spending too much vertical
       space on it. 36px still clears SC 2.5.8's 24px floor comfortably. */
    min-inline-size: 40px;
    min-block-size: 36px;
    padding-inline: 0.65rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: lowercase;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .navDrawer__toggle::-webkit-details-marker {
    display: none;
  }

  /* F7 — while open it becomes the X, pinned inside the panel's top-right padding box.
     `fixed` (not `relative`) so it lands at a known inset rather than wherever the header
     happens to have placed it; z-index 42 keeps it above the panel, which is what F1 QA
     caught it failing to do. */
  .navDrawer[open] .navDrawer__toggle {
    position: fixed;
    inset-block-start: 1.5rem;
    inset-inline-end: 1.5rem;
    z-index: 42;
    inline-size: 44px;
    padding-inline: 0;
    background: var(--color-surface);
    font-size: var(--text-base);
  }
  .navDrawer__word--open,
  .navDrawer[open] .navDrawer__word--closed {
    display: none;
  }
  .navDrawer[open] .navDrawer__word--open {
    display: inline;
  }

  .navDrawer__scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: block;
    background: var(--color-text);
    opacity: 0.45;
  }

  .navDrawer__panel {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 41;
    /* C4: ~80% width, capped so it never becomes a full-bleed sheet on a large phone. */
    inline-size: 80%;
    max-inline-size: 22rem;
    /* internally scrollable — a long nav must never be unreachable */
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-surface);
    border-inline-start: 1px solid var(--color-border);
    /* C4 custom scrollbar — thin, in our own tokens, not the platform default. */
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
  }
  .navDrawer__panel::-webkit-scrollbar {
    inline-size: 6px;
  }
  .navDrawer__panel::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: var(--radius-sm);
  }
  .navDrawer__panel::-webkit-scrollbar-track {
    background: transparent;
  }

  /* F7 slide-in. The transform/opacity start state is applied ONLY when the island has
     marked the drawer with `data-nav-animate`, so with JS off the panel simply appears in
     place instead of being stranded off-screen at translateX(100%) forever. Transform and
     opacity only — no layout is animated. */
  [data-nav-animate] .navDrawer__panel {
    transform: translateX(100%);
    transition: transform 280ms ease-out;
  }
  [data-nav-animate] .navDrawer__scrim {
    opacity: 0;
    transition: opacity 280ms ease-out;
  }
  [data-nav-animate] .navDrawer__toggle {
    transition: opacity 280ms ease-out;
  }
  [data-nav-animate].is-open .navDrawer__panel {
    transform: translateX(0);
  }
  [data-nav-animate].is-open .navDrawer__scrim {
    opacity: 0.45;
  }

  /* §4.4 rule 6 — reduced motion gets the end state instantly, never a slide. The global
     rule already crushes durations; this makes the intent local and explicit. */
  @media (prefers-reduced-motion: reduce) {
    [data-nav-animate] .navDrawer__panel,
    [data-nav-animate] .navDrawer__scrim,
    [data-nav-animate] .navDrawer__toggle {
      transition: none;
    }
  }

  .navDrawer__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    padding-block: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    text-transform: lowercase;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }
  .navDrawer__link:hover {
    color: var(--color-text);
  }
  .navDrawer__link--current {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .navDrawer__rule {
    display: block;
    block-size: 1px;
    background: var(--color-border);
  }

  .navDrawer__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    border: 1px solid var(--color-accent-strong);
    border-radius: var(--radius-sm);
    background: var(--color-accent-strong);
    color: var(--color-accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: lowercase;
  }
  .navDrawer__cta:hover {
    filter: brightness(0.9);
  }

  /* The drawer is a below-lg affordance only; nothing of it may leak onto desktop. This
     scoped rule is what actually hides it — a bare `lg:hidden` utility cannot outrank the
     `.navDrawer { margin-inline-start: auto }` block's specificity on the element — so it
     MUST stay in lockstep with the utility on the element. 768 → 1024 (2026-08-30). */
  @media (min-width: 1024px) {
    .navDrawer {
      display: none;
    }
  }
</style>

<script>
  // SANCTIONED ISLAND (operator directive, Stage 5B F1) — the mobile nav drawer.
  // ENHANCEMENT ONLY, in the shape §4.2.9 already sanctions for FilterBar: the <details>
  // opens, closes and is keyboard-operable natively. This adds the four things markup
  // cannot do — background scroll lock, focus trap, scrim tap, and Escape-to-close with
  // focus returned to the toggle. With JS off, everything still works via `menu`/`close`.
  const drawer = document.querySelector<HTMLDetailsElement>('[data-nav-drawer]');
  if (drawer) {
    const panel = drawer.querySelector<HTMLElement>('[data-nav-panel]');
    const scrim = drawer.querySelector<HTMLElement>('[data-nav-scrim]');
    const toggle = drawer.querySelector<HTMLElement>('summary');

    // F7 — opt the CSS into the slide only now that JS is running. Without this attribute
    // the panel has no transform, so a no-JS visitor gets it in place rather than parked
    // off-screen at translateX(100%).
    drawer.dataset.navAnimate = '';

    const SLIDE_MS = 280;
    const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)');

    const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled])';

    // A <details> hides its content the instant `open` flips, so a close transition would
    // never be seen. Hold `open` true, play the slide-out, then drop it.
    let closing = 0;
    const close = (returnFocus: boolean) => {
      if (!drawer.open || closing) return;
      drawer.classList.remove('is-open');
      const finish = () => {
        window.clearTimeout(closing);
        closing = 0;
        drawer.open = false;
        document.documentElement.style.overflow = '';
        if (returnFocus) toggle?.focus();
      };
      if (reduced?.matches) return finish();
      closing = window.setTimeout(finish, SLIDE_MS);
    };

    // Intercept the summary's own click for the CLOSE direction only; opening stays native.
    toggle?.addEventListener('click', (event) => {
      if (!drawer.open) return;
      event.preventDefault();
      close(true);
    });

    drawer.addEventListener('toggle', () => {
      if (!drawer.open) return;
      // Scroll lock on the root element, so the page behind cannot move while the drawer
      // is open. Paired with `overscroll-behavior: contain` on the panel.
      document.documentElement.style.overflow = 'hidden';
      // Next frame, so the browser has painted the off-screen start state and the
      // transition to translateX(0) actually runs instead of being coalesced away.
      requestAnimationFrame(() => drawer.classList.add('is-open'));
      // Focus the PANEL, not the first link. Focus must enter the drawer for the trap and
      // for screen readers, but landing it on a link paints the §4.6 focus ring around a
      // full-width row that reads like a text input and collides with the X. A container
      // with tabindex="-1" is the standard dialog answer: focus moves, nothing is styled.
      panel?.focus({ preventScroll: true });
    });

    scrim?.addEventListener('click', () => close(true));

    // The drawer's amber CTA opens `#install-site`, which is a FIXED overlay at z-index 60 —
    // it would otherwise render on top of a drawer that is still open behind it, with the
    // drawer's scroll lock still applied underneath the modal's. Close the drawer on the way
    // through. `returnFocus: false` matters: the modal has already moved focus into its own
    // sheet by then, and yanking it back to a link that is about to be display:none would
    // break the trap. The drawer's lock is an inline style and the modal's is a class, so
    // clearing one cannot clear the other.
    panel?.querySelectorAll<HTMLElement>('[data-install-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => close(false));
    });

    document.addEventListener('keydown', (event) => {
      if (!drawer.open) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
        return;
      }

      if (event.key !== 'Tab' || !panel) return;

      // Focus trap: the toggle plus everything in the panel form the loop, so Shift+Tab off
      // the first item lands on `close` rather than escaping to the page behind.
      const items = [toggle, ...Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE))].filter(
        (el): el is HTMLElement => Boolean(el)
      );
      if (!items.length) return;

      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      } else if (active instanceof HTMLElement && !items.includes(active)) {
        event.preventDefault();
        first.focus();
      }
    });

    // A resize past the breakpoint must not strand a locked scroll behind a hidden drawer.
    // 1024 must match the `lg` boundary the CSS hides `.navDrawer` at (2026-08-30, moved
    // from 768 with the rest). If this number and that media query ever disagree, a resize
    // into the gap leaves `documentElement.style.overflow = 'hidden'` set on a page whose
    // drawer is already display:none — an unscrollable page with no visible way out.
    window.addEventListener('resize', () => {
      if (drawer.open && window.innerWidth >= 1024) close(false);
    });
  }
</script>
