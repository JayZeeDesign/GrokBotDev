---
interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className = '' } = Astro.props;
const style = `inline-size: ${size}px; block-size: ${size}px;`;
---

<svg
  viewBox="0 0 36 36"
  aria-hidden="true"
  role="presentation"
  class:list={["shrink-0 text-text", className]}
  style={style}
>
  <g class="fill-current">
    <rect x="6" y="5" width="7" height="10" rx="3.5" transform="rotate(-20 9.5 10)" />
    <rect x="14.5" y="5" width="7" height="10" rx="3.5" transform="rotate(-20 18 10)" />
    <circle cx="27" cy="10" r="3.25" />
    <circle cx="9.5" cy="18" r="3.25" />
    <circle cx="18" cy="18" r="3.25" />
    <circle cx="27" cy="18" r="3.25" />
    <circle cx="9.5" cy="27" r="3.25" />
    <circle cx="27" cy="27" r="3.25" />
  </g>
  <circle class="fill-accent" cx="18" cy="27" r="3.25" />
</svg>
