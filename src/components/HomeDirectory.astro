---
// HOME = THE DIRECTORY. Two tabs (operator, 2026-08-28): SHAREABLE BOTS (default) and PLUGINS.
//
// Awesome Use Cases has LEFT this page — /use-cases/ is fully intact and now reachable from the
// header nav instead. The operator's call: the sectioned shareable-bots skim is the thing worth
// landing on, and three tabs would have buried it.
//
// The shareable-bots panel is the SECTIONED skim (TemplateSections), complete and uncapped —
// not a featured slice. Plugins keeps its featured-first table/cards switch unchanged.
// Still radio + :has(), still zero islands for the tab machinery itself.
import EntryCard from './EntryCard.astro';
import Chip from './Chip.astro';
import PluginIcon from './PluginIcon.astro';
import TemplateSections from './TemplateSections.astro';
import { toCardEntry, kindOf, sortSponsorsFirst } from '../lib/entries';
import PluginSubmitCTA from './PluginSubmitCTA.astro';
import type { AnyDoc } from '../lib/entries';
import type { TemplateDoc } from '../lib/templates';
import { CP_147_MARKETPLACE_INTRO, CP_165_HOME_SHAREABLE_ALL, CP_175_HOME_TAB_TEMPLATES } from '../lib/copy';
import categories from '../data/categories.json';

interface Props {
  plugins: AnyDoc[];
  templates: TemplateDoc[];
}

const { plugins, templates } = Astro.props;
const labelOf = (slug: string) => categories.find((c) => c.slug === slug)?.label ?? slug;

const isFeatured = (d: AnyDoc) => Boolean(d.data.featured);
// Operator: sponsors on top (client-shuffled per load), rest alphabetical.
const featuredPlugins = sortSponsorsFirst(plugins.filter(isFeatured));
---

<section class="homeDirectory container-page flex flex-col gap-6 pt-6 pb-12 md:pt-8 md:pb-16" aria-label="directory">
  {/* ── TAB SWITCHER — segmented control (base A) + count boxes (from C) ───────────────── */}
  <input type="radio" name="home-tab" id="home-tab-templates" class="sr-only" checked />
  <input type="radio" name="home-tab" id="home-tab-plugins" class="sr-only" />

  <div class="flex justify-center" role="presentation">
    <div class="homeTabs">
      <label for="home-tab-templates" data-home-tab="templates" class="homeTab">
        {CP_175_HOME_TAB_TEMPLATES} <span class="homeTab__n">{templates.length}</span>
      </label>
      <label for="home-tab-plugins" data-home-tab="plugins" class="homeTab">
        plugins <span class="homeTab__n">{plugins.length}</span>
      </label>
    </div>
  </div>

  {/* ── PLUGINS ─────────────────────────────────────────────────────────────────────── */}
  <div data-home-panel="plugins" class="flex flex-col gap-4">
    <div class="homeMeta flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="homeMeta__count">
        <strong>{featuredPlugins.length}</strong> featured
        <span aria-hidden="true">·</span>
        <span class="homeMeta__total">{plugins.length} total</span>
        <span aria-hidden="true">·</span>
        <a href="/plugins/" class="homeMeta__all">view all {plugins.length} →</a>
      </span>

      {/* Table|Cards — icons only, plugins only. */}
      <div class="homeView flex items-center gap-2 sm:ml-auto" data-home-view-switch>
        <input type="radio" name="home-view" id="home-view-table" class="sr-only" checked />
        <input type="radio" name="home-view" id="home-view-cards" class="sr-only" />
        <label for="home-view-table" data-home-view="table" class="homeViewBtn" title="table view">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
            <rect x="1" y="2.5" width="14" height="2.2" rx="0.6" />
            <rect x="1" y="6.9" width="14" height="2.2" rx="0.6" />
            <rect x="1" y="11.3" width="14" height="2.2" rx="0.6" />
          </svg>
          <span class="sr-only">table view</span>
        </label>
        <label for="home-view-cards" data-home-view="cards" class="homeViewBtn" title="cards view">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
            <rect x="1" y="1" width="6.2" height="6.2" rx="1" />
            <rect x="8.8" y="1" width="6.2" height="6.2" rx="1" />
            <rect x="1" y="8.8" width="6.2" height="6.2" rx="1" />
            <rect x="8.8" y="8.8" width="6.2" height="6.2" rx="1" />
          </svg>
          <span class="sr-only">cards view</span>
        </label>
      </div>
    </div>

    {/* TABLE — featured plugins: favicon + name · tagline · category. */}
    <div data-home-view-panel="table" class="homeTableWrap">
      <table class="homeTable">
        <thead>
          <tr>
            <th scope="col">Plugin</th>
            <th scope="col" class="homeTable__tagline">What it does</th>
            <th scope="col">Category</th>
          </tr>
        </thead>
        <tbody data-rot-group>
          {
            featuredPlugins.map((doc) => {
              const p = doc.data as { slug: string; name: string; tagline: string; category: string; sponsor?: boolean };
              return (
              <tr data-rot-pin={p.sponsor ? 'true' : undefined}>
                <td>
                  <span class="flex items-center gap-3">
                    <PluginIcon slug={p.slug} name={p.name} size="sm" />
                    <a href={`/plugins/${p.slug}/`} class="homeTable__name">
                      {p.name}
                    </a>
                    {p.sponsor && <span class="homeTable__flag">sponsor</span>}
                  </span>
                </td>
                <td class="homeTable__tagline">{p.tagline}</td>
                <td>
                  <Chip variant="category" label={labelOf(p.category)} href={`/categories/${p.category}/`} />
                </td>
              </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    {/* CARDS */}
    <div data-home-view-panel="cards" data-rot-group class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-6">
      {featuredPlugins.map((doc) => (
        <div data-rot-pin={(doc.data as { sponsor?: boolean }).sponsor ? 'true' : undefined} class="contents">
          <EntryCard entry={toCardEntry(doc)} variant={kindOf(doc)} headingLevel={3} />
        </div>
      ))}
    </div>

    {/* Operator (2026-08-26): same prominent exit as the use-cases tab — off the featured
        set into the full, filterable hub. */}
    <div class="homeAllRow">
      <a href="/plugins/" class="homeAllBtn">all plugins ({plugins.length}) →</a>
    </div>

    <PluginSubmitCTA class="mt-2" />
  </div>

  {/* ── SHAREABLE BOTS (default tab) ──────────────────────────────────────────────────── */}
  <div data-home-panel="templates" class="flex flex-col gap-4">
    <div class="homeMeta flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="homeMeta__count">
        <strong>{templates.length}</strong>
        <span>shareable bots, grouped by what they do</span>
        <span aria-hidden="true">·</span>
        <a href="/marketplace/" class="homeMeta__all">{CP_165_HOME_SHAREABLE_ALL}</a>
      </span>
    </div>

    <p class="homeShareIntro max-w-prose text-base text-text-muted">{CP_147_MARKETPLACE_INTRO}</p>

    {/* Section headings are h3 here: they sit under the page h1 and this panel's own meta row,
        and the hub renders the identical component at h2. Rows follow one level down. */}
    <TemplateSections templates={templates} headingLevel={3} idPrefix="home" />

    <div class="homeAllRow">
      <a href="/marketplace/" class="homeAllBtn">filter and search all {templates.length} →</a>
    </div>
  </div>

</section>

<style>
  /* ---------- tab switcher: segmented control (base A) + count boxes (from C) ---------- */
  /* One bordered track holding both segments — reads as "two views of one list", not two
     separate buttons. Active segment fills with ink; each label carries a count box. */
  .homeTabs {
    display: inline-flex;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    max-inline-size: 100%;
  }
  .homeTab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 40px;
    padding-inline: 1rem;
    border-radius: 1px;
    font-family: var(--font-mono);
    text-transform: lowercase;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .homeTab:hover {
    color: var(--color-text);
  }
  .homeTab__n {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 1px;
    padding-inline: 0.375rem;
  }
  /* Active segment: ink fill, and the count box inverts to stay legible on it. */
  .homeDirectory:has(#home-tab-templates:checked) [data-home-tab='templates'],
  .homeDirectory:has(#home-tab-plugins:checked) [data-home-tab='plugins'] {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .homeDirectory:has(#home-tab-templates:checked) [data-home-tab='templates'] .homeTab__n,
  .homeDirectory:has(#home-tab-plugins:checked) [data-home-tab='plugins'] .homeTab__n {
    color: var(--color-bg);
    border-color: currentColor;
  }
  /* F6 / C4 (operator, "make it perfect"): at full size the two segments
     ("awesome use cases 98" + "plugins 18") overran the content column ~24px at 375px and took
     the page sideways (proven by hide-and-remeasure). Shrink the type, inline padding, gap and
     count box on narrow phones so the whole track fits the column; `max-inline-size: 100%` on
     .homeTabs already caps the track, this makes the CONTENT fit inside that cap. */
  @media (max-width: 430px) {
    .homeTab {
      padding-inline: 0.625rem;
      gap: 0.375rem;
      font-size: var(--text-sm);
    }
    .homeTab__n {
      padding-inline: 0.25rem;
    }
  }

  /* ---------- view switch (table | cards, plugins only) ---------- */
  .homeViewBtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 32px;
    min-inline-size: 36px;
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    text-transform: lowercase;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }
  .homeViewBtn:hover {
    color: var(--color-text);
  }
  .homeDirectory:has(#home-view-table:checked) [data-home-view='table'],
  .homeDirectory:has(#home-view-cards:checked) [data-home-view='cards'] {
    border-color: var(--color-accent-strong);
    background: var(--color-accent-strong);
    color: var(--color-accent-contrast);
  }

  /* ---------- count / view-all line ---------- */
  .homeMeta__count {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .homeMeta__count strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .homeMeta__all {
    color: var(--color-accent-text);
    text-decoration: none;
  }
  .homeMeta__all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- bottom "all use cases" button (operator) ---------- */
  /* Centered, bordered pill under the featured grid — a clear exit into the full hub. Neutral
     (not the amber fill) so it does not compete with the one accent per viewport. */
  .homeAllRow {
    display: flex;
    justify-content: center;
    margin-block-start: 0.5rem;
  }
  .homeAllBtn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 44px;
    padding-inline: 1.5rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: lowercase;
    color: var(--color-text);
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .homeAllBtn:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  /* ---------- panel visibility ---------- */
  .homeDirectory [data-home-panel] {
    display: none;
  }
  .homeDirectory:has(#home-tab-templates:checked) [data-home-panel='templates'],
  .homeDirectory:has(#home-tab-plugins:checked) [data-home-panel='plugins'] {
    display: flex;
  }

  .homeDirectory [data-home-view-panel] {
    display: none;
  }
  .homeDirectory:has(#home-view-table:checked) [data-home-view-panel='table'] {
    display: block;
  }
  .homeDirectory:has(#home-view-cards:checked) [data-home-view-panel='cards'] {
    display: grid;
  }

  /* ---------- table ---------- */
  .homeTableWrap {
    overflow-x: auto;
    max-inline-size: 100%;
  }
  .homeTable {
    inline-size: 100%;
    border-collapse: collapse;
    text-align: start;
  }
  .homeTable th {
    padding: 0.5rem 0.75rem;
    border-block-end: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: lowercase;
    color: var(--color-text-muted);
    text-align: start;
    white-space: nowrap;
  }
  .homeTable td {
    padding: 0.75rem;
    border-block-end: 1px solid var(--color-border);
    vertical-align: middle;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .homeTable tbody tr:hover {
    background: var(--color-surface);
  }
  .homeTable__name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
  }
  .homeTable__name:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .homeTable__flag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: lowercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    padding: 1px 5px;
  }
  @media (max-width: 639px) {
    .homeTable__tagline {
      display: none;
    }
  }
</style>

<script>
  // Operator: sponsors on top in RANDOM order per load; rest alphabetical (server-sorted).
  // Shuffles only the sponsor block in the table AND the cards grid. CSP-clean bundle.
  document.querySelectorAll<HTMLElement>('[data-rot-group]').forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLElement>(':scope > [data-rot-pin]'));
    if (items.length < 2) return;
    const anchor = items[items.length - 1].nextElementSibling;
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    items.forEach((item) => group.insertBefore(item, anchor));
  });
</script>
