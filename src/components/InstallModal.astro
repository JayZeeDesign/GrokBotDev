---
// Addendum B3 — `InstallModal`: the human bridge to §7. SANCTIONED ISLAND #6-of-6
// (added to §12.5's allowed list by B3; see BUILD-NOTES on the M1.3 amendment).
// Operator, verbatim: "some sort of 'Install this in Grok Bot' modal and your Bot will
// keep getting newest craziest things people build, curated from X, suggesting it to you."
//
// a11y contract (B3): focus-trap, Esc closes, background scroll locked, mobile
// full-height sheet, generous copy buttons, no tiny code.
// No backend: everything is templated static text + copy actions.
//
// NO-JS: the panel is a `:target` overlay — the trigger is a real anchor and the close
// control is a real link, so the whole thing works with the island disabled (§4.4 rule 7).
//
// Copy: CP-102 title · CP-103/104 section headings · CP-105 body · CP-106 schedules ·
// CP-107 agent link · CP-108 browse link · CP-109 trigger · CP-112 (FENCED) CTA sentence.
//
// ── 2026-08-22 (operator) — THE TWO VARIANTS ARE DISJOINT AND THE `site` ONE IS GLOBAL ──
//   · `entry` renders ONLY the entry's own install (name + prompt, or install steps). The
//     feed/subscribe section it used to carry as well is gone from this variant — see the
//     note on the body below for why.
//   · `site` renders ONLY the feed/subscribe flow, and `BaseLayout` renders exactly ONE of
//     it (`#install-site`) on every page. Three surfaces open it: the header CTA
//     (SiteHeader), the ambient nudge (ConnectNudge) and the inline callouts
//     (ConnectCallout) — plus the home hero's own button. All of them are real anchors
//     carrying `data-install-trigger="install-site"`, so every one of them still works with
//     the island disabled (§4.4 rule 7). A page that owns a BUTTON but not the panel passes
//     `renderModal={false}`; nothing may render a second `#install-site`.
import PromptBlock from './PromptBlock.astro';
import {
  CP_102_INSTALL_TITLE,
  CP_103_INSTALL_SECTION1,
  CP_121_INSTALL_SECTION2,
  CP_122_INSTALL_STEP_1,
  CP_123_INSTALL_STEP_2,
  CP_124_ROUTINE_PROMPT,
  CP_124_CADENCE,
  CP_107_INSTALL_AGENT_LINK,
  CP_108_INSTALL_BROWSE_LINK,
  CP_109_INSTALL_TRIGGER,
  CP_112_CTA_SENTENCE,
} from '../lib/copy';

interface Props {
  /** `entry` = per-entry placement (B3 a) · `site` = home-hero placement (B3 b). */
  variant?: 'entry' | 'site';
  /** Unique per page — ids, radio group name and aria wiring derive from it. */
  id?: string;
  /** Entry variant: the entry's copy-paste prompt (§05 `prompt`). */
  prompt?: string;
  /** Entry variant: install steps, used when the entry carries no prompt (§05). */
  installSteps?: string[];
  entryName?: string;
  /** Render the built-in trigger; pass false when the page owns the button. */
  renderTrigger?: boolean;
  /**
   * Render the panel itself. The `site` panel is now GLOBAL — `BaseLayout` renders exactly
   * one `#install-site` on every page — so a page that only owns a BUTTON pointing at it
   * passes `renderModal={false}` and gets the trigger markup without a duplicate id.
   */
  renderModal?: boolean;
  triggerLabel?: string;
  class?: string;
}

const {
  variant = 'entry',
  id = variant === 'site' ? 'site' : 'entry',
  prompt,
  installSteps = [],
  entryName,
  renderTrigger = true,
  renderModal = true,
  triggerLabel,
  class: className = '',
} = Astro.props;

const modalId = `install-${id}`;
const titleId = `${modalId}-title`;

// Operator (2026-08-25): the cadence picker is gone. The feed routine now defaults to a
// DAILY check, so the modal renders exactly one prompt. CP-124 is the operator's one-liner;
// the full §7.3 machine contract is untouched and still lives on /agent/ (CP-107).
const dailyRoutinePrompt = CP_124_ROUTINE_PROMPT(CP_124_CADENCE.daily);

const defaultTrigger =
  triggerLabel ?? (variant === 'site' ? CP_102_INSTALL_TITLE : CP_109_INSTALL_TRIGGER);
---

{
  renderTrigger && (
    <a
      href={`#${modalId}`}
      data-install-trigger={modalId}
      class:list={[
        'inline-flex min-h-6 items-center justify-center gap-2 rounded-sm border border-accent-strong bg-accent-strong px-4 py-2 font-mono text-sm lowercase text-accent-contrast btn-active hover:brightness-90',
        className,
      ]}
    >
      {defaultTrigger}
    </a>
  )
}

{renderModal && (
<div class="install-modal" id={modalId} data-install-modal data-pagefind-ignore>
  <a class="install-modal__scrim" href="#main" data-install-close tabindex="-1" aria-hidden="true"
  ></a>

  <div
    class="install-modal__sheet"
    role="dialog"
    aria-modal="true"
    aria-labelledby={titleId}
    data-install-sheet
  >
    <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
      <h2 id={titleId} class="font-display text-xl text-text display-track">
        {CP_102_INSTALL_TITLE}
      </h2>
      <a
        href="#main"
        data-install-close
        class="inline-flex min-h-6 min-w-6 items-center justify-center rounded-sm border border-border-interactive font-mono text-sm text-text-muted hover:border-accent hover:text-accent-text"
      >
        <span aria-hidden="true">×</span>
        <span class="sr-only">close</span>
      </a>
    </div>

    <div class="install-modal__body flex flex-col gap-8 p-4">
      {/* ── THE TWO VARIANTS ARE NOW DISJOINT (operator, 2026-08-22) ────────────────────
          B3 shipped the `entry` variant as section 1 + section 2, so pressing "install in
          grok bot" on a single opened a panel that answered a question the reader had not
          asked: below their entry's prompt sat the whole subscribe-to-the-feed cadence
          picker. Operator's verdict: confusing. It is also a §A1-shaped fault — two
          different asks stacked in one plane, neither of them clearly the point.

          The feed pitch is NOT deleted; it MOVED audience, the same way CP-124's machine
          contract moved to /agent/. It now lives on the ONE `site` panel that BaseLayout
          renders globally, and three surfaces point at it (header CTA, ambient nudge,
          inline callouts). So: `entry` = this entry's install, and nothing else. `site` =
          the feed, and nothing else. */}
      {
        variant === 'entry' && (
          <section class="flex flex-col gap-3">
            <h3 class="font-mono text-sm lowercase text-text-muted">{CP_103_INSTALL_SECTION1}</h3>
            {entryName && <p class="font-sans text-lg font-medium text-text">{entryName}</p>}
            {prompt ? (
              <>
                <PromptBlock prompt={prompt} copyLabel="copy prompt" />
                <p class="text-base text-text">{CP_112_CTA_SENTENCE}.</p>
              </>
            ) : (
              <ol class="flex flex-col gap-2 border-l border-border pl-4">
                {installSteps.map((step, index) => (
                  <li class="flex gap-3">
                    <span class="font-mono text-sm text-accent-text">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="text-base text-text-muted">{step}</span>
                  </li>
                ))}
              </ol>
            )}
          </section>
        )
      }

      {variant === 'site' && (
      <section class="flex flex-col gap-4">
        {/* Operator: this is the value-prop line, not a title — extended copy, rendered as
            body text (smaller than the old display h3). It sets up the steps below. */}
        <p class="max-w-prose text-sm leading-relaxed text-text-muted">{CP_121_INSTALL_SECTION2}</p>

        {/* F10(3) — two numbered steps, one line each: mono index in accent + text at
            --text-base. Restored verbatim (operator, 2026-08-25). */}
        <ol class="flex flex-col gap-2">
          <li class="flex items-baseline gap-3">
            <span class="font-mono text-sm text-accent-text">1</span>
            <span class="text-base text-text">{CP_122_INSTALL_STEP_1}</span>
          </li>
          <li class="flex items-baseline gap-3">
            <span class="font-mono text-sm text-accent-text">2</span>
            <span class="text-base text-text">{CP_123_INSTALL_STEP_2}</span>
          </li>
        </ol>

        {/* Operator (2026-08-25): cadence picker removed — single daily routine prompt below.
            `.schedule-picker` wrapper kept ONLY so the copy button still reports as
            `subscribe_copy` (the island JS keys off `closest('.schedule-picker')`). */}
        <div class="schedule-picker flex flex-col gap-3">
          <PromptBlock
            prompt={dailyRoutinePrompt}
            label="routine · daily"
            copyLabel="copy routine prompt"
            copyVariant="slate"
            align="start"
          />
        </div>

        {/* Both links are site-only now that the whole section is — the inner
            `variant === 'site'` guard the browse link used to carry is redundant. */}
        <div class="flex flex-wrap items-center gap-4 font-mono text-sm">
          <a href="/plugins/" class="text-text-muted underline underline-offset-4 hover:text-accent-text">
            {CP_108_INSTALL_BROWSE_LINK}
          </a>
          <a href="/agent/" class="text-text-muted underline underline-offset-4 hover:text-accent-text">
            {CP_107_INSTALL_AGENT_LINK}
          </a>
        </div>
      </section>
      )}
    </div>
  </div>
</div>
)}

<style is:global>
  .install-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 60;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  /* No-JS: `:target` opens it. With JS: the island sets [data-open]. */
  .install-modal:target,
  .install-modal[data-open] {
    display: flex;
  }

  .install-modal__scrim {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: 0.9;
  }

  .install-modal__sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 720px;
    /* F10(1) — 85vh at ALL viewports, and `min-block-size: 0` on the body below is what
       actually lets a COLUMN flex child scroll: without it the child's automatic minimum is
       its content height, so `overflow-y: auto` never engages and the sheet just grows.
       F6 set `min-inline-size: 0` — the same bug on the other axis. */
    max-height: 85vh;
    min-block-size: 0;
    /* F10(6) — the SITE variant renders inside the hero's `#content`, which is
       `text-align: center`. The sheet was inheriting it, which is why the prompt (and the
       heading, and the steps) came out centred. Centred prose in a copy-paste block is
       wrong, and a modal should never inherit its host's alignment. Reset once, here,
       rather than per element. */
    text-align: start;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .install-modal__body {
    /* F6 — the modal scrolls INTERNALLY and VERTICALLY ONLY. `overflow-x: clip` is the
       backstop: even if some future child refuses to wrap, it gets clipped here instead of
       widening the sheet and taking the page sideways with it. `min-inline-size: 0` cancels
       the automatic min-content floor a flex item gets, which is what let an unbreakable URL
       push this container wider than the viewport in the first place. */
    overflow-y: auto;
    overflow-x: clip;
    min-inline-size: 0;
    /* the other half of the F10(1) fix — see the sheet's max-height note */
    min-block-size: 0;
  }

  /* Same floor on the sheet and on every direct child of the body, for the same reason. */
  .install-modal__sheet {
    min-inline-size: 0;
  }
  .install-modal__body > * {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /* B3: mobile full-height sheet. */
  @media (max-width: 640px) {
    .install-modal {
      padding: 0;
    }

    .install-modal__sheet {
      max-width: none;
      height: 100dvh;
      max-height: 100dvh;
      min-block-size: 0;
      border: 0;
      border-radius: 0;
    }
  }

  /* Background scroll lock while a modal is open. */
  html.install-modal-open,
  body.install-modal-open {
    overflow: hidden;
  }
</style>

<script>
  // Island: focus trap + Esc + scroll lock + focus restore. Analytics events are
  // emitted through the sitewide `grokbotTrack` hook (§9.7 owns the transport):
  // install_modal_open · install_copy · subscribe_copy.
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])';

  type Tracker = (event: string, props?: Record<string, string>) => void;
  const track: Tracker = (event, props) => {
    (window as unknown as { grokbotTrack?: Tracker }).grokbotTrack?.(event, props);
  };

  document.querySelectorAll<HTMLElement>('[data-install-modal]').forEach((modal) => {
    const sheet = modal.querySelector<HTMLElement>('[data-install-sheet]');
    if (!sheet) return;

    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      modal.setAttribute('data-open', 'true');
      document.documentElement.classList.add('install-modal-open');
      document.body.classList.add('install-modal-open');
      const first = sheet.querySelector<HTMLElement>(FOCUSABLE);
      (first ?? sheet).focus({ preventScroll: true });
      track('install_modal_open', { modal: modal.id });
    };

    const close = () => {
      modal.removeAttribute('data-open');
      document.documentElement.classList.remove('install-modal-open');
      document.body.classList.remove('install-modal-open');
      lastFocused?.focus({ preventScroll: true });
    };

    document.querySelectorAll<HTMLAnchorElement>(`[data-install-trigger="${modal.id}"]`).forEach(
      (trigger) => {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          open();
        });
      }
    );

    modal.querySelectorAll<HTMLAnchorElement>('[data-install-close]').forEach((closer) => {
      closer.addEventListener('click', (event) => {
        event.preventDefault();
        close();
      });
    });

    modal.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (key !== 'Tab') return;

      const focusable = Array.from(sheet.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (element) => element.offsetParent !== null || element === document.activeElement
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const shift = (event as KeyboardEvent).shiftKey;

      if (shift && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!shift && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Copy analytics: section 1 = install_copy, section 2 = subscribe_copy.
    modal.querySelectorAll<HTMLElement>('[data-copy-trigger]').forEach((button) => {
      button.addEventListener('click', () => {
        const isRoutine = Boolean(button.closest('.schedule-picker'));
        track(isRoutine ? 'subscribe_copy' : 'install_copy', { modal: modal.id });
      });
    });
  });
</script>
