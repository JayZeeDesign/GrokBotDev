---
// §4.3.2 / §4.3.4 / §4.3.6 — the shared lane-index page body.
// §6.3 short H1s (Plugins / Awesome Use Cases / Collections) per CP-019/029/036 + C3.3;
// the descriptor lives in the intro. A9 density: every row carries a two-digit mono index.
import Breadcrumbs from './Breadcrumbs.astro';
import SearchInput from './SearchInput.astro';
import FilterBar from './FilterBar.astro';
import EntryCard from './EntryCard.astro';
import EmptyState from './EmptyState.astro';
import Pagination from './Pagination.astro';
import NewsletterRow from './NewsletterRow.astro';
import PluginIcon from './PluginIcon.astro';
import Chip from './Chip.astro';
import RotatingSponsorSlot from './RotatingSponsorSlot.astro';
import { integrationSlug, integrationsOf, kindOf, toCardEntry } from '../lib/entries';
import type { AnyDoc } from '../lib/entries';
import type { WaitlistSource } from '../lib/types';
import categories from '../data/categories.json';

interface Props {
  h1: string;
  intro: string;
  entries: AnyDoc[];
  /** Astro paginate() page data. */
  page: { currentPage: number; lastPage: number; url: { prev?: string; next?: string } };
  baseUrl: string;
  variant: 'plugin' | 'use-case' | 'collection';
  facets: Array<'category' | 'integration' | 'type'>;
  source: WaitlistSource;
  /** Whole-lane pool, so facet counts do not shrink page by page. */
  pool: AnyDoc[];
  laneLabel: string;
  /** Operator: /plugins/ renders a scannable TABLE; everything else stays on cards. */
  layout?: 'cards' | 'table';
  /** Operator: /plugins/ and /use-cases/ carry one rotating sponsored slot. */
  showSponsorSlot?: boolean;
}

const {
  h1,
  intro,
  entries,
  page,
  baseUrl,
  variant,
  facets,
  source,
  pool,
  laneLabel,
  layout = 'cards',
  showSponsorSlot = false,
} = Astro.props;

const categoryLabel = (slug: string) => categories.find((c) => c.slug === slug)?.label ?? slug;

const categoryCounts = new Map<string, number>();
const integrationCounts = new Map<string, number>();
for (const entry of pool) {
  categoryCounts.set(entry.data.category, (categoryCounts.get(entry.data.category) ?? 0) + 1);
  for (const tool of integrationsOf(entry)) {
    integrationCounts.set(tool, (integrationCounts.get(tool) ?? 0) + 1);
  }
}

const options = {
  categories: [...categoryCounts.entries()].map(([label, count]) => ({
    label,
    href: `/categories/${label}/`,
    count,
    current: false,
  })),
  integrations: [...integrationCounts.entries()].map(([label, count]) => ({
    label,
    href: `/integrations/${integrationSlug(label)}/`,
    count,
    current: false,
  })),
  types: [
    { label: 'plugin', href: '/plugins/', count: 0, current: variant === 'plugin' },
    { label: 'use case', href: '/use-cases/', count: 0, current: variant === 'use-case' },
  ],
};

const offset = (page.currentPage - 1) * 24;
const crumbs = [{ label: 'home', href: '/' }, { label: laneLabel }];
const searchScope = variant === 'collection' ? undefined : { type: variant };
---

<div class="container-page flex flex-col gap-12 py-12 md:py-16">
  <header class="flex flex-col gap-4">
    <Breadcrumbs items={crumbs} />
    <h1 class="display-track font-display text-3xl text-text md:text-4xl">{h1}</h1>
    <p class="max-w-prose text-base text-text-muted">{intro}</p>
  </header>

  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
    {
      searchScope ? (
        <SearchInput mode="link" hiddenFields={searchScope} class="md:max-w-md md:flex-1" />
      ) : (
        <span />
      )
    }
    <FilterBar facets={facets} options={options} clearHref={baseUrl} />
  </div>

  {showSponsorSlot && <RotatingSponsorSlot />}

  {
    entries.length === 0 ? (
      <EmptyState variant="hub" />
    ) : layout === 'table' ? (
      // Operator: the plugin listing is a scannable TABLE — favicon+name | what it does |
      // category (rightmost). The wrapper scrolls horizontally on a phone (the table keeps a
      // min-width so columns never crush) and never widens the page past the viewport.
      <div class="hubTableWrap" role="region" aria-label={`${laneLabel} table`} tabindex="0">
        <table class="hubTable">
          <thead>
            <tr>
              <th scope="col">{variant === 'plugin' ? 'plugin' : 'name'}</th>
              <th scope="col" class="hubTable__desc">what it does</th>
              <th scope="col" class="hubTable__catcol">category</th>
            </tr>
          </thead>
          <tbody data-sponsor-shuffle-group>
            {entries.map((entry) => {
              const p = entry.data as { slug: string; name: string; tagline: string; category: string; sponsor?: boolean };
              return (
              <tr data-sponsor-item={p.sponsor ? 'true' : undefined}>
                <td>
                  <span class="flex items-center gap-3">
                    {variant === 'plugin' && (
                      <PluginIcon slug={p.slug} name={p.name} size="sm" />
                    )}
                    <a href={`${baseUrl}${p.slug}/`} class="hubTable__name">
                      {p.name}
                    </a>
                    {p.sponsor && <span class="hubTable__sponsor">sponsor</span>}
                  </span>
                </td>
                <td class="hubTable__desc">{p.tagline}</td>
                <td class="hubTable__catcol">
                  <Chip
                    variant="category"
                    label={categoryLabel(p.category)}
                    href={`/categories/${p.category}/`}
                  />
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : (
      // §4.5 gives collections their OWN grid row (1 / 1 / 2 / 2 — "collections are wider
      // cards", §4.3.6). Every other lane uses the standard EntryCard row (1 / 2 / 2 / 3).
      // Fixed at M7.1 QA: all three lanes were rendering the standard grid.
      <div
        class:list={[
          'grid grid-cols-1 gap-4 md:gap-6',
          variant === 'collection' ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3',
        ]}
      >
        {entries.map((entry, index) => (
          <div class="flex flex-col gap-2">
            <span class="font-mono text-xs text-text-muted">
              {String(offset + index + 1).padStart(2, '0')}
            </span>
            <EntryCard entry={toCardEntry(entry)} variant={kindOf(entry)} headingLevel={2} />
          </div>
        ))}
      </div>
    )
  }

  {
    page.lastPage > 1 && (
      <Pagination
        page={{
          current: page.currentPage,
          total: page.lastPage,
          prevUrl: page.url.prev,
          nextUrl: page.url.next,
          baseUrl,
        }}
      />
    )
  }

  <NewsletterRow source={source} />
</div>

<style>
  /* Operator: plugin listing = table. The wrapper is the ONLY thing that scrolls (C4 high-pri:
     a table never widens the page past the viewport); the table keeps a min-width so on a phone
     the columns stay legible and you swipe sideways instead of them crushing. */
  .hubTableWrap {
    overflow-x: auto;
    max-inline-size: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .hubTableWrap:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    outline-offset: 2px;
  }
  .hubTable {
    inline-size: 100%;
    min-inline-size: 620px;
    border-collapse: collapse;
    text-align: start;
  }
  .hubTable th {
    padding: 0.625rem 1rem;
    border-block-end: 1px solid var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: lowercase;
    color: var(--color-text-muted);
    text-align: start;
    white-space: nowrap;
  }
  .hubTable td {
    padding: 0.75rem 1rem;
    border-block-end: 1px solid var(--color-border);
    vertical-align: middle;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .hubTable tbody tr:last-child td {
    border-block-end: 0;
  }
  .hubTable tbody tr:hover {
    background: var(--color-surface);
  }
  .hubTable__name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
  }
  .hubTable__name:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hubTable__desc {
    min-inline-size: 16rem;
  }
  .hubTable__catcol {
    white-space: nowrap;
  }
  .hubTable__sponsor {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: lowercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    padding: 1px 5px;
  }
</style>

<script>
  // Operator: sponsors sit on top in RANDOM order per page load; the rest stay alphabetical.
  // The server renders sponsors first (alphabetical, for no-JS/SEO); this shuffles only the
  // sponsor block. Bundled module — CSP-clean.
  document.querySelectorAll<HTMLElement>('[data-sponsor-shuffle-group]').forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLElement>(':scope > [data-sponsor-item]'));
    if (items.length < 2) return;
    const anchor = items[items.length - 1].nextElementSibling; // first non-sponsor (or null)
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    items.forEach((item) => group.insertBefore(item, anchor));
  });
</script>
