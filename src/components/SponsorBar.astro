---
// The narrow-viewport sponsor strip (operator). Sits just under the header and shows the same
// sponsors as the desktop rails, as a horizontal tape that loops when it overflows.
//
// It hides itself when the fixed rails take over — but NOT via its own media query. It reads
// `--sr-tape-display`, which the generated rail stylesheet sets to `none` above the derived
// breakpoint. Two reasons that indirection is right:
//   · the breakpoint is derived, and a scoped <style> here could not use it;
//   · YTT §4: the "narrow" trigger and the "too few sponsors" trigger must come from ONE
//     source or they drift. When railPlan() says rails are not viable, railCss() emits nothing
//     at all, --sr-tape-display is never set, and this tape stays visible at EVERY width —
//     which is exactly the "never lay out a half-empty rail" fallback, with no second switch.
//
// Class names are deliberately generic (adblock neutrality, YTT §5) — `rel="sponsored"` stays,
// because that is disclosure rather than a display hook.
import { SPONSORS, sponsorHref, sponsorIconPath } from '../lib/sponsors';
const scroll = SPONSORS.length > 3;
const items = scroll ? [...SPONSORS, ...SPONSORS] : SPONSORS;
---

{
  SPONSORS.length > 0 && (
    <aside class="topStrip" aria-label="partners" data-pagefind-ignore>
      {/* VISIBLE text stays "sponsors" — that is disclosure, and disclosure is not something
          we obfuscate. Only the landmark's aria-label (a trivially filter-listed attribute)
          is neutral; a cosmetic filter cannot practically key off body text. */}
      <a href="/sponsors/" class="topStrip__label">sponsors</a>
      <div class="topStrip__view">
        <ul
          class:list={['topStrip__track', scroll && 'topStrip__track--scroll']}
          data-rot
          data-rot-unit={SPONSORS.length}
        >
          {items.map((s, i) => (
            <li>
              <a
                href={sponsorHref(s)}
                target="_blank"
                rel="sponsored noopener"
                class="stripItem"
                style={`--tint: var(--color-partner-${s.tint}-tint)`}
                aria-hidden={scroll && i >= SPONSORS.length ? 'true' : undefined}
                tabindex={scroll && i >= SPONSORS.length ? -1 : undefined}
              >
                {sponsorIconPath(s) ? (
                  <img src={sponsorIconPath(s)!} alt="" width="18" height="18" class="stripItem__icon" loading="lazy" />
                ) : (
                  <span class="stripItem__tile" aria-hidden="true">{s.name.charAt(0)}</span>
                )}
                <span class="stripItem__name">{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

<style>
  .topStrip {
    /* `none` above the rail breakpoint, set by the generated rail stylesheet. Absent — i.e.
       sponsors off, or too few sponsors for rails — the fallback keeps the tape visible. */
    display: var(--sr-tape-display, flex);
    align-items: center;
    gap: 12px;
    padding: 6px 16px;
    border-block-end: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
  }
  .topStrip__label {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .topStrip__view {
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 16px, black calc(100% - 16px), transparent);
    mask-image: linear-gradient(to right, transparent, black 16px, black calc(100% - 16px), transparent);
  }
  .topStrip__track {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    inline-size: max-content;
  }
  .topStrip__track--scroll {
    animation: stripTape 30s linear infinite;
  }
  .topStrip__view:active .topStrip__track--scroll,
  .topStrip__view:hover .topStrip__track--scroll,
  .topStrip__view:focus-within .topStrip__track--scroll {
    animation-play-state: paused;
  }
  @keyframes stripTape {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .topStrip__track--scroll {
      animation: none;
    }
    .topStrip__view {
      overflow-x: auto;
    }
  }
  .stripItem {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 6px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--tint);
    text-decoration: none;
    white-space: nowrap;
  }
  .stripItem__icon,
  .stripItem__tile {
    inline-size: 18px;
    block-size: 18px;
    border-radius: 4px;
    object-fit: cover;
  }
  .stripItem__tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 11px;
    color: var(--color-text);
  }
  .stripItem__name {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text);
  }
</style>

<script>
  // Operator: sponsors show in RANDOM order — so no sponsor is permanently first/most-visible.
  // Runs once (this strip is always in the DOM when sponsors are on) and shuffles EVERY sponsor
  // list on the page: this strip plus both desktop rails ([data-rot]). Bundled module =
  // same-origin, CSP-clean. The rotating sponsor slot shuffles itself separately.
  //
  // Hook names are deliberately generic (adblock neutrality): `data-rot` / `data-rot-unit` /
  // `data-rot-show` — a filter list that kills `[data-sponsor-*]` would have removed the whole
  // unit. NOTE: `[data-rot]` is an exact attribute-name match, so it does NOT collide with the
  // unrelated `[data-rot-group]` used by the entry listings (renamed in the same pass — it sat
  // on the home directory itself, so a false-positive filter there would have hidden the site's
  // main content, not an ad).
  const shuffle = (a: HTMLElement[]): HTMLElement[] => {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };

  // A card past the visible slot count is clipped by the rail, so take it out of the tab order
  // and the a11y tree too — otherwise it is a link you can focus but never see.
  const setInert = (li: HTMLElement, inert: boolean): void => {
    const a = li.querySelector('a');
    if (!a) return;
    if (inert) {
      a.setAttribute('aria-hidden', 'true');
      a.setAttribute('tabindex', '-1');
    } else {
      a.removeAttribute('aria-hidden');
      a.removeAttribute('tabindex');
    }
  };

  document.querySelectorAll<HTMLElement>('[data-rot]').forEach((ul) => {
    const n = parseInt(ul.getAttribute('data-rot-unit') || '0', 10);
    // Rails only: how many of the n cards actually fit. 0/absent = show everything.
    const show = parseInt(ul.getAttribute('data-rot-show') || '0', 10);
    const kids = Array.from(ul.children) as HTMLElement[];
    if (!n || kids.length < 2) return;

    if (kids.length === n) {
      // No marquee duplication — reorder in place. On a rail that holds more sponsors than it
      // has slots, this is also what rotates the spare into view: the shuffle decides which
      // cards land in the visible slots, so a fifth sponsor is seen on ~2 of every 3 pageviews
      // instead of never.
      const real = shuffle(kids);
      real.forEach((li) => ul.appendChild(li));
      if (show > 0) real.forEach((li, i) => setInert(li, i >= show));
      return;
    }

    // Marquee: n real items + a duplicated tail for the seamless loop. Shuffle the real n,
    // then rebuild the tail as clones of the shuffled order so the loop stays seamless.
    const real = shuffle(kids.slice(0, n));
    kids.forEach((li) => li.remove());
    real.forEach((li) => {
      setInert(li, false);
      ul.appendChild(li);
    });
    real.forEach((li) => {
      const clone = li.cloneNode(true) as HTMLElement;
      setInert(clone, true);
      ul.appendChild(clone);
    });
  });
</script>
