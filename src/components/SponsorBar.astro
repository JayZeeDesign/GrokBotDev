---
// SponsorBar — the mobile / narrow-viewport sponsor strip (operator). Sits just under the
// header and shows the same sponsors as the desktop rails, as a horizontal tape that loops
// when it overflows. Hidden on wide screens, where the fixed rails take over.
import { SPONSORS, sponsorHref, sponsorIconPath } from '../lib/sponsors';
const scroll = SPONSORS.length > 3;
const items = scroll ? [...SPONSORS, ...SPONSORS] : SPONSORS;
---

{
  SPONSORS.length > 0 && (
    <aside class="sponsorBar" aria-label="sponsors" data-pagefind-ignore>
      <a href="/sponsors/" class="sponsorBar__label">sponsors</a>
      <div class="sponsorBar__viewport">
        <ul
          class:list={['sponsorBar__tape', scroll && 'sponsorBar__tape--scroll']}
          data-sponsor-shuffle
          data-sponsor-unit={SPONSORS.length}
        >
          {items.map((s, i) => (
            <li>
              <a
                href={sponsorHref(s)}
                target="_blank"
                rel="sponsored noopener"
                class="sponsorChip"
                style={`--tint: var(--color-sponsor-${s.tint}-tint)`}
                aria-hidden={scroll && i >= SPONSORS.length ? 'true' : undefined}
                tabindex={scroll && i >= SPONSORS.length ? -1 : undefined}
              >
                {sponsorIconPath(s) ? (
                  <img src={sponsorIconPath(s)!} alt="" width="18" height="18" class="sponsorChip__icon" loading="lazy" />
                ) : (
                  <span class="sponsorChip__tile" aria-hidden="true">{s.name.charAt(0)}</span>
                )}
                <span class="sponsorChip__name">{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

<style>
  .sponsorBar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 16px;
    border-block-end: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
  }
  /* The fixed rails take over on wide screens — but only where the gutter is real (≥1600px,
     matching SponsorRail). Keeping the bar up to 1600 closes the 1440–1600 dead zone where
     the rails used to overlap the content and the bar was already hidden. */
  @media (min-width: 1600px) {
    .sponsorBar {
      display: none;
    }
  }
  .sponsorBar__label {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .sponsorBar__viewport {
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 16px, black calc(100% - 16px), transparent);
    mask-image: linear-gradient(to right, transparent, black 16px, black calc(100% - 16px), transparent);
  }
  .sponsorBar__tape {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    inline-size: max-content;
  }
  .sponsorBar__tape--scroll {
    animation: sponsorBarTape 30s linear infinite;
  }
  .sponsorBar__viewport:active .sponsorBar__tape--scroll,
  .sponsorBar__viewport:hover .sponsorBar__tape--scroll {
    animation-play-state: paused;
  }
  @keyframes sponsorBarTape {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sponsorBar__tape--scroll {
      animation: none;
    }
    .sponsorBar__viewport {
      overflow-x: auto;
    }
  }
  .sponsorChip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 6px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--tint);
    text-decoration: none;
    white-space: nowrap;
  }
  .sponsorChip__icon,
  .sponsorChip__tile {
    inline-size: 18px;
    block-size: 18px;
    border-radius: 4px;
    object-fit: cover;
  }
  .sponsorChip__tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 11px;
    color: var(--color-text);
  }
  .sponsorChip__name {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text);
  }
</style>

<script>
  // Operator: sponsors show in RANDOM order — so no sponsor is permanently first/most-visible.
  // Runs once (this bar is always in the DOM when sponsors are on) and shuffles EVERY sponsor
  // list on the page: this bar plus both desktop rails ([data-sponsor-shuffle]). Bundled
  // module = same-origin, CSP-clean. The rotating sponsor slot shuffles itself separately.
  const shuffle = (a: HTMLElement[]): HTMLElement[] => {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };

  document.querySelectorAll<HTMLElement>('[data-sponsor-shuffle]').forEach((ul) => {
    const n = parseInt(ul.getAttribute('data-sponsor-unit') || '0', 10);
    const kids = Array.from(ul.children) as HTMLElement[];
    if (!n || kids.length < 2) return;

    if (kids.length === n) {
      // No marquee duplication — just reorder the items.
      shuffle(kids).forEach((li) => ul.appendChild(li));
      return;
    }

    // Marquee: n real items + a duplicated tail for the seamless loop. Shuffle the real n,
    // then rebuild the tail as clones of the shuffled order so the loop stays seamless.
    const real = shuffle(kids.slice(0, n));
    kids.forEach((li) => li.remove());
    real.forEach((li) => {
      const a = li.querySelector('a');
      if (a) {
        a.removeAttribute('aria-hidden');
        a.removeAttribute('tabindex');
      }
      ul.appendChild(li);
    });
    real.forEach((li) => {
      const clone = li.cloneNode(true) as HTMLElement;
      const a = clone.querySelector('a');
      if (a) {
        a.setAttribute('aria-hidden', 'true');
        a.setAttribute('tabindex', '-1');
      }
      ul.appendChild(clone);
    });
  });
</script>
