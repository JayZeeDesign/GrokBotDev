---
// The Shareable Bots filter — multi-select tag chips + text search.
//
// SHIPS `hidden`. The island's first act is to un-hide it, so a reader with JS off gets the
// complete server-rendered list and zero controls that do nothing (§4.4 rule 7). That is the
// same shape `UpvoteButton` uses, and the inverse of shipping a control that silently no-ops.
//
// SORT IS NOT IN HERE. Newest and featured are two static ROUTES (/marketplace/ and
// /marketplace/featured/), exactly the way LaneIndexPage's sort control already serves newest
// and awesome-score as server-rendered views. Only filtering and search need JS.
//
// Chips are grouped in one <fieldset> per facet with the facet name as <legend>, so the
// grouping is in the accessibility tree and not only in the visual layout.
import {
  CP_153_TEMPLATE_FILTER_HEADING,
  CP_154_TEMPLATE_FILTER_PLACEHOLDER,
  CP_155_TEMPLATE_FILTER_CLEAR,
  CP_156_TEMPLATE_FILTER_COUNT,
} from '../lib/copy';
import { tagFacets, type TagFacet } from '../lib/templates';

interface Props {
  /** Per-tag counts across the whole rendered set, so a chip never offers a zero. */
  counts: Map<string, number>;
  class?: string;
}

const { counts, class: className = '' } = Astro.props;

// Only offer tags that are actually in use. A vocabulary of 36 with 30 templates would
// otherwise render a wall of chips most of which filter to nothing.
const facets: TagFacet[] = tagFacets()
  .map((facet) => ({ ...facet, tags: facet.tags.filter((tag) => (counts.get(tag.slug) ?? 0) > 0) }))
  .filter((facet) => facet.tags.length > 0);
---

<form
  class:list={['tplFilter', className]}
  data-template-filter
  action="/marketplace/"
  method="get"
  hidden
  data-pagefind-ignore
>
  <div class="tplFilter__top">
    <label class="sr-only" for="tpl-q">search shareable bots</label>
    <input
      id="tpl-q"
      type="search"
      name="q"
      class="tplFilter__search"
      placeholder={CP_154_TEMPLATE_FILTER_PLACEHOLDER}
      data-template-search
    />
    <button type="button" class="tplFilter__clear" data-template-clear>
      {CP_155_TEMPLATE_FILTER_CLEAR}
    </button>
    <p
      class="tplFilter__count"
      role="status"
      aria-live="polite"
      data-template-count
      data-template-count-template={CP_156_TEMPLATE_FILTER_COUNT}
    />
  </div>

  <h2 class="sr-only">{CP_153_TEMPLATE_FILTER_HEADING}</h2>

  <div class="tplFilter__facets">
    {
      facets.map((facet) => (
        <fieldset class="tplFilter__facet">
          <legend class="tplFilter__legend">{facet.label}</legend>
          <div class="tplFilter__chips">
            {facet.tags.map((tag) => (
              <button
                type="button"
                class="tplFilter__chip"
                data-template-tag={tag.slug}
                data-template-tag-facet={facet.facet}
                aria-pressed="false"
              >
                {tag.label.toLowerCase()}
                <span class="tplFilter__n">{counts.get(tag.slug)}</span>
              </button>
            ))}
          </div>
        </fieldset>
      ))
    }
  </div>
</form>

<script>
  import '../scripts/template-filter';
</script>

<style>
  .tplFilter[hidden] {
    display: none;
  }
  .tplFilter {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .tplFilter__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .tplFilter__search {
    flex: 1 1 16rem;
    min-inline-size: 0;
    min-block-size: 2.25rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    padding-inline: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .tplFilter__search::placeholder {
    color: var(--color-text-muted);
  }
  .tplFilter__clear {
    min-block-size: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: lowercase;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .tplFilter__clear:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }
  .tplFilter__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-inline-start: auto;
  }

  .tplFilter__facets {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .tplFilter__facet {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.5rem;
  }
  .tplFilter__legend {
    float: none;
    inline-size: 100%;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: lowercase;
    color: var(--color-text-muted);
  }
  .tplFilter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* 24px floor per WCAG 2.2 SC 2.5.8; the chips are the one dense control here. */
  .tplFilter__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-block-size: 1.75rem;
    padding-inline: 0.625rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: lowercase;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s,
      background-color 0.15s;
  }
  .tplFilter__chip:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }
  /* Selected state is INK, not amber: §A1 keeps the one accent per plane for the actions. */
  .tplFilter__chip[aria-pressed='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
  }
  .tplFilter__n {
    font-size: 10px;
    opacity: 0.75;
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
